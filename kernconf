# Combine all filter configs
FILTER_CONFIGS = {
    'critical': CRITICAL_CONFIGS,
    'important': {**CRITICAL_CONFIGS, **IMPORTANT_CONFIGS},  # important includes critical
}


class KernelConfigParser:
    """Parse kernel config files (.config, defconfig)"""

    def __init__(self):
        self.configs: Dict[str, str] = {}
        self.comments: List[str] = []
        self._line_map: Dict[str, int] = {}  # config -> line number for ordering

    def parse(self, filepath: str) -> 'KernelConfigParser':
        """Parse a kernel config file"""
        self.configs = {}
        self.comments = []
        self._line_map = {}

        if not os.path.exists(filepath):
            raise FileNotFoundError(f"Config file not found: {filepath}")

        with open(filepath, 'r') as f:
            lines = f.readlines()

        for i, line in enumerate(lines):
            line = line.rstrip('\n')
            stripped = line.strip()

            # Skip empty lines
            if not stripped:
                self.comments.append(line)
                continue

            # Comments
            if stripped.startswith('#'):
                self.comments.append(line)
                # Check for "CONFIG_X is not set"
                if ' is not set' in stripped:
                    config_name = stripped[1:].split(' is not set')[0].strip()
                    self.configs[config_name] = 'n'
                    self._line_map[config_name] = i
                continue

            # CONFIG_*=value
            if '=' in stripped and stripped.startswith('CONFIG_'):
                key, value = stripped.split('=', 1)
                self.configs[key] = value
                self._line_map[key] = i
                continue

            # Other lines (shouldn't happen in valid config)
            self.comments.append(line)

        return self

    def get(self, key: str, default: str = None) -> str:
        return self.configs.get(key, default)

    def keys(self) -> Set[str]:
        return set(self.configs.keys())

    def items(self) -> Dict[str, str]:
        return self.configs.copy()

    def write(self, filepath: str, preserve_order: bool = True):
        """Write config to file"""
        lines = []

        if preserve_order and self._line_map:
            # Sort by original line number
            sorted_configs = sorted(self.configs.items(), key=lambda x: self._line_map.get(x[0], 999999))
        else:
            sorted_configs = sorted(self.configs.items())

        for key, value in sorted_configs:
            if value == 'n':
                lines.append(f"# {key} is not set")
            else:
                lines.append(f"{key}={value}")

        with open(filepath, 'w') as f:
            f.write('\n'.join(lines) + '\n')


def load_config(filepath: str) -> KernelConfigParser:
    """Load and parse a kernel config file"""
    parser = KernelConfigParser()
    parser.parse(filepath)
    return parser


def get_filter_configs(filter_name: str) -> Dict[str, str]:
    """Get the filter config list"""
    if filter_name not in FILTER_CONFIGS:
        raise ValueError(f"Unknown filter: {filter_name}. Available: {list(FILTER_CONFIGS.keys())}")
    return FILTER_CONFIGS[filter_name]


def compare_configs(source: KernelConfigParser, device: KernelConfigParser, filter_name: Optional[str] = None) -> Tuple[List[Tuple[str, str, str]], List[str], List[str]]:
    """
    Compare source config (base) with device config.

    If filter_name is provided, only compare configs in the filter list.
    Otherwise, compare all configs that exist in SOURCE.
    """
    source_keys = source.keys()
    device_keys = device.keys()

    if filter_name:
        # Filter mode: basis is the filter list, not source
        filter_keys = set(get_filter_configs(filter_name).keys())
        # Only compare configs that exist in BOTH filter and device
        common_keys = filter_keys & device_keys
    else:
        # Normal mode: basis is source
        common_keys = source_keys & device_keys

    differences = []
    for key in sorted(common_keys):
        src_val = source.get(key)
        dev_val = device.get(key)
        if src_val != dev_val:
            differences.append((key, src_val, dev_val))

    if filter_name:
        filter_keys = set(get_filter_configs(filter_name).keys())
        only_in_filter = sorted(filter_keys - device_keys)
        only_in_device = sorted(device_keys & filter_keys)  # device keys that are in filter
        only_in_source = []  # not applicable in filter mode
    else:
        only_in_source = sorted(source_keys - device_keys)
        only_in_device = sorted(device_keys - source_keys)
        only_in_filter = []

    return differences, only_in_source, only_in_device, only_in_filter


def sync_configs(source: KernelConfigParser, device: KernelConfigParser, filter_name: Optional[str] = None) -> KernelConfigParser:
    """
    Create synced config: source base with device values for common keys.
    If filter_name provided, also add filter configs that don't exist in source.
    """
    source_keys = source.keys()
    device_keys = device.keys()

    synced = KernelConfigParser()
    synced.configs = source.configs.copy()
    synced._line_map = source._line_map.copy()
    synced.comments = source.comments.copy()

    if filter_name:
        # Filter mode: basis is filter list
        filter_configs = get_filter_configs(filter_name)
        filter_keys = set(filter_configs.keys())

        # For each filter config, use device value if exists, else keep source, else add from filter
        for key in filter_keys:
            if key in device_keys:
                synced.configs[key] = device.get(key)
                if key not in synced._line_map:
                    synced._line_map[key] = 999999  # append at end
            elif key in source_keys:
                # Keep source value
                pass
            else:
                # Not in source or device - we don't add unknowns
                pass
    else:
        # Normal mode: update with device values for keys that exist in BOTH
        common_keys = source_keys & device_keys
        for key in common_keys:
            synced.configs[key] = device.get(key)

    return synced


def cmd_check(args):
    """Check command: compare configs"""
    try:
        source = load_config(args.source_config)
        device = load_config(args.device_config)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    differences, only_in_source, only_in_device, only_in_filter = compare_configs(source, device, args.filter)

    if args.filter:
        filter_configs = get_filter_configs(args.filter)
        print(f"=== Kernel Config Comparison (FILTER: {args.filter.upper()}) ===")
        print(f"Source: {args.source_config} ({len(source.keys())} configs)")
        print(f"Device: {args.device_config} ({len(device.keys())} configs)")
        print(f"Filter configs: {len(filter_configs)} ({args.filter})")
        print(f"Compared (filter ∩ device): {len(set(filter_configs.keys()) & device.keys())}")
        print(f"Differences: {len(differences)}")
        print(f"Filter configs missing in device: {len(only_in_filter)}")
        print()
    else:
        print(f"=== Kernel Config Comparison ===")
        print(f"Source: {args.source_config} ({len(source.keys())} configs)")
        print(f"Device: {args.device_config} ({len(device.keys())} configs)")
        print(f"Common: {len(source.keys() & device.keys())} configs")
        print(f"Only in source: {len(only_in_source)}")
        print(f"Only in device (ignored): {len(only_in_device)}")
        print(f"Differences: {len(differences)}")
        print()

    if differences:
        print(f"=== DIFFERENCES ({'filter' if args.filter else 'source'} vs device) ===")
        print(f"{'CONFIG':<55} {'SOURCE':<15} {'DEVICE':<15}")
        print("-" * 85)
        for key, src_val, dev_val in differences:
            desc = ""
            if args.filter and key in get_filter_configs(args.filter):
                desc = f"  # {get_filter_configs(args.filter)[key]}"
            src_display = src_val if src_val is not None else 'MISSING'
            print(f"{key:<55} {src_display:<15} {dev_val:<15}{desc}")
    else:
        print("✓ No differences in compared configs")

    if args.verbose:
        if args.filter and only_in_filter:
            print()
            print(f"=== FILTER CONFIGS MISSING IN DEVICE ===")
            for key in only_in_filter:
                desc = get_filter_configs(args.filter).get(key, '')
                print(f"{key}=MISSING  # {desc}")

        if not args.filter and only_in_source:
            print()
            print("=== ONLY IN SOURCE (not in device) ===")
            for key in only_in_source:
                val = source.get(key)
                print(f"{key}={val}")

        if not args.filter and only_in_device:
            print()
            print("=== ONLY IN DEVICE (ignored per spec) ===")
            for key in only_in_device:
                val = device.get(key)
                print(f"{key}={val}")

    # Exit code: 0 = no differences, 1 = differences found
    sys.exit(0 if len(differences) == 0 else 1)


def cmd_sync(args):
    """Sync command: create synced config"""
    try:
        source = load_config(args.source_config)
        device = load_config(args.device_config)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    differences, only_in_source, only_in_device, only_in_filter = compare_configs(source, device, args.filter)

    # Create synced config
    synced = sync_configs(source, device, args.filter)

    # Determine output path
    if args.output:
        output_path = args.output
    else:
        # Default: source config name with _synced suffix
        source_path = Path(args.source_config)
        filter_suffix = f"_{args.filter}" if args.filter else ""
        output_path = str(source_path.parent / f"{source_path.stem}_synced{filter_suffix}{source_path.suffix}")

    # Write synced config
    synced.write(output_path)

    if args.filter:
        filter_configs = get_filter_configs(args.filter)
        print(f"=== Kernel Config Sync (FILTER: {args.filter.upper()}) ===")
        print(f"Source: {args.source_config}")
        print(f"Device: {args.device_config}")
        print(f"Output: {output_path}")
        print(f"Filter configs: {len(filter_configs)} ({args.filter})")
        print(f"Differences resolved: {len(differences)}")
        print(f"Filter configs missing in device: {len(only_in_filter)}")
        print()
    else:
        print(f"=== Kernel Config Sync ===")
        print(f"Source: {args.source_config}")
        print(f"Device: {args.device_config}")
        print(f"Output: {output_path}")
        print(f"Common configs synced: {len(source.keys() & device.keys())}")
        print(f"Differences resolved: {len(differences)}")
        print(f"Device-only configs ignored: {len(only_in_device)}")
        print(f"Source-only configs preserved: {len(only_in_source)}")
        print()

    print(f"✓ Synced config written to: {output_path}")


def main():
    parser = argparse.ArgumentParser(
        description="Kernel config comparison and synchronization tool",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kernconf check ./kernel/arch/arm64/configs/lavender_defconfig ./lavender.devconfig
  kernconf check ./kernel/arch/arm64/configs/lavender_defconfig ./lavender.devconfig --filter critical
  kernconf check ./kernel/arch/arm64/configs/lavender_defconfig ./lavender.devconfig --filter important
  kernconf sync ./kernel/arch/arm64/configs/lavender_defconfig ./lavender.devconfig -o lavender_synced_defconfig
  kernconf sync ./kernel/arch/arm64/configs/lavender_defconfig ./lavender.devconfig --filter critical -o lavender_critical_defconfig

Filters:
  critical  - Bootloop-causing configs (HZ, modules, KSU, preempt, ARM64 errata, etc.)
  important - Critical + important configs (fs, memory, net, debug, power, android, etc.)

Behavior:
  - check: Compares device config against source config BASE.
           Only shows differences for configs that EXIST in source.
           Configs only in device are IGNORED (not shown by default).
    With --filter: Basis changes to filter list. Shows differences for filter configs.
                   Filter configs missing in device are reported.

  - sync:  Creates a new config based on source, with device values
           for common keys. Device-only configs are IGNORED.
           Source-only configs are PRESERVED.
    With --filter: Also ensures all filter configs are present in output.
                   Missing filter configs are added with device values.
"""
    )
    subparsers = parser.add_subparsers(dest='command', required=True)

    # check command
    check_parser = subparsers.add_parser('check', help='Compare source config vs device config')
    check_parser.add_argument('source_config', help='Source kernel config (base)')
    check_parser.add_argument('device_config', help='Device config (reference)')
    check_parser.add_argument('-v', '--verbose', action='store_true', help='Show only-in-source and ignored device configs')
    check_parser.add_argument('--filter', choices=['critical', 'important'], help='Filter mode: critical (bootloop-causing) or important (critical + important)')

    # sync command
    sync_parser = subparsers.add_parser('sync', help='Sync source config with device config')
    sync_parser.add_argument('source_config', help='Source kernel config (base)')
    sync_parser.add_argument('device_config', help='Device config (reference)')
    sync_parser.add_argument('-o', '--output', help='Output path (default: <source>_synced<ext>)')
    sync_parser.add_argument('--filter', choices=['critical', 'important'], help='Filter mode: critical (bootloop-causing) or important (critical + important)')

    args = parser.parse_args()

    if args.command == 'check':
        cmd_check(args)
    elif args.command == 'sync':
        cmd_sync(args)


if __name__ == '__main__':
    main()