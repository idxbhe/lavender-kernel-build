#!/usr/bin/env python3
"""
drspace-install — Install Droidspaces OSS kernel configurations.
Usage:
    ./drspace-install [<kernel_source_path>] <defconfig_rel_path> [--include-optional] [--skip-patch] [--dry-run]

Arguments:
    kernel_source_path : path to kernel source tree (contains Makefile) (default: current working directory)
    defconfig_rel_path : path to defconfig relative to <kernel_source>/arch/arm64/configs
                         (e.g. vendor/lavender-perf_defconfig)

Flags:
    --include-optional  : include optional configurations (UFW/Fail2ban, USER_NS, TMPFS_XATTR, etc.)
    --skip-patch        : skip patching step, only configure defconfig
    --dry-run           : show what would be done without making changes
    --verbose, -v       : verbose Kconfig symbol resolution notes (use when adding fallbacks)
    --backup            : create a .bak copy of the defconfig before editing (opt-in; default: no backup)
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# Manual patch engine import (robust, no external .patch dependency)
try:
    import importlib.util
    _mpe_path = Path(__file__).resolve().parent / "manual_patch_engine.py"
    _spec = importlib.util.spec_from_file_location("manual_patch_engine", str(_mpe_path))
    _manual_engine = importlib.util.module_from_spec(_spec)
    _spec.loader.exec_module(_manual_engine)
except Exception:
    _manual_engine = None

