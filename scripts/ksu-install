#!/usr/bin/env bash
# ksu-install - KernelSU Original (non-GKI) Integration Script
# Production-ready, robust implementation following official KernelSU documentation
#
# This script integrates KernelSU (original/tiann) into non-GKI kernel source trees.
# It does NOT use setup.sh - instead, it uses a git submodule at external/KernelSU.
#
# Usage: ksu-install [options] <method> <kernel_source_dir> [defconfig_path]
#   method: manual | kprobe
#   kernel_source_dir: path to kernel source tree (must be writable)
#   defconfig_path: required for full integration, optional for standalone backport mode

set -euo pipefail

# ============================================================================
# Constants & Configuration
# ============================================================================
readonly SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_VERSION="1.0.0"
readonly KSU_BRANCH="main"
readonly KSU_TAG="v0.9.5"  # Last version supporting non-GKI (per official docs)

# Repo root (where external/KernelSU submodule lives)
# Script is at scripts/ksu-install, so root is parent of script dir
readonly LAVENDER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly KSU_SUBMODULE_PATH="$LAVENDER_ROOT/external/KernelSU"
readonly KSU_KERNEL_SOURCE="$KSU_SUBMODULE_PATH/kernel"

# Options / Flags
SKIP_KSU_FETCH=0
SKIP_PATCHES=0
INTEGRATE_COPY=0   # --integrate: copy KSU source into kernel tree instead of symlink
CREATE_BACKUP=0    # --backup: create backup files before patching (default: no backup)
BACKPORT_PATH_UMOUNT=0
BACKPORT_DEVPTS=0
BACKPORT_SAFE_MODE=0
BACKPORT_ALL=0
ANY_BACKPORT_SET=0

# Required kernel configs for kprobe method (KernelSU original)
# CONFIG_OVERLAY_FS=y is required because the upstream KernelSU Kconfig declares
# `depends on OVERLAY_FS` regardless of integration method. Without it,
# `make defconfig` / `make olddefconfig` silently drops CONFIG_KSU=y (the
# user-visible symptom: KSU never compiles, no `$(info -- KernelSU version: ...)`
# log appears, no kernelsu.o is produced). The C code itself does not require
# OVERLAY_FS, so this is purely a Kconfig-level dependency that we must satisfy.
readonly KPROBE_CONFIGS=(
    "CONFIG_KPROBES=y"
    "CONFIG_HAVE_KPROBES=y"
    "CONFIG_KPROBE_EVENTS=y"
    "CONFIG_OVERLAY_FS=y"
    "CONFIG_KSU=y"
)

# Required kernel configs for manual method
# (same OVERLAY_FS=y rationale as KPROBE_CONFIGS above)
readonly MANUAL_CONFIGS=(
    "CONFIG_OVERLAY_FS=y"
    "CONFIG_KSU=y"
)

# Files to patch for manual integration (KernelSU original: 4 files, NO reboot.c)
readonly MANUAL_PATCH_FILES=(
    "fs/exec.c"
    "fs/open.c"
    "fs/read_write.c"
    "fs/stat.c"
)

# Backport definitions: file path + verification hook
readonly BACKPORT_PATH_UMOUNT_FILE="fs/namespace.c"
readonly BACKPORT_PATH_UMOUNT_HOOK="path_umount"

readonly BACKPORT_DEVPTS_FILE="fs/devpts/inode.c"
readonly BACKPORT_DEVPTS_HOOK="ksu_handle_devpts"

readonly BACKPORT_SAFE_MODE_FILE="drivers/input/input.c"
readonly BACKPORT_SAFE_MODE_HOOK="ksu_handle_input_handle_event"

# ============================================================================
# Logging & Output Functions
# ============================================================================
log_info()    { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
log_success() { printf '\033[1;32m[OK]\033[0m   %s\n' "$*"; }
log_warn()    { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
log_error()   { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; }
log_debug()   { [[ "${DEBUG:-0}" -eq 1 ]] && printf '\033[1;36m[DEBUG]\033[0m %s\n' "$*"; return 0; }
log_step()    { printf '\n\033[1;35m>>> %s\033[0m\n' "$*"; }

die() {
    log_error "$*"
    exit 1
}

# ============================================================================
# Patch Helper Functions
# ============================================================================
detect_indent() {
    local file="$1"
    local line="$2"
    local indent=""
    local char
    char=$(sed -n "${line}p" "$file" | sed -n 's/^\([ \t]*\).*/\1/p')
    if [[ -n "$char" ]]; then
        indent="$char"
    else
        indent="    "
    fi
    echo "$indent"
}

find_function_start() {
    local file="$1"
    local pattern="$2"
    local start_line="${3:-1}"
    awk -v start="$start_line" -v pat="$pattern" '
        NR >= start && $0 ~ pat { print NR; exit }
    ' "$file"
}

find_function_end() {
    local file="$1"
    local start_line="$2"
    local pattern="$3"
    awk -v start="$start_line" -v pat="$pattern" '
        NR >= start && $0 ~ pat { print NR; exit }
    ' "$file"
}

find_next_line_matching() {
    local file="$1"
    local start_line="$2"
    local pattern="$3"
    awk -v start="$start_line" -v pat="$pattern" '
        NR > start && $0 ~ pat { print NR; exit }
    ' "$file"
}

# find_after_declarations FILE START_LINE
#   Scan lines from START_LINE+1 (typically the line after a function's opening
#   brace) and return the line number where the first *executable statement*
#   begins (i.e. the line just AFTER all local declarations).
#
#   Why this exists: clang with -Werror,-Wdeclaration-after-statement (which is
#   the default for Android kernel builds via scripts/kompile) refuses any
#   statement that is followed by a declaration. If we insert a hook call at
#   the top of a function body and the function then declares local variables
#   afterwards, the kernel file fails to compile with
#       error: mixing declarations and code is a C99 extension
#              [-Werror,-Wdeclaration-after-statement]
#   Solution: insert the hook call AFTER all the local declarations, i.e. at
#   the position where execution would otherwise begin. This matches the
#   original upstream KernelSU patch placement and is always safe.
#
#   Heuristic: a line is treated as a declaration if it
#     - is empty or contains only a comment, OR
#     - ends with ';' and matches the shape `^\s*(<type-specifiers>)* <name>\s*(=...)?\s*;`
#       where the type-specifiers include the common C storage/type keywords
#       (const, static, unsigned, signed, struct/union/enum tags handled via
#       leading identifier tokens, plus plain int/char/long/etc.).
#   We scan until we find a line that is NOT a declaration; that line is the
#   first executable statement. Return its line number so the caller can
#   insert_before_line it (so the hook lands at the end of the declaration
#   block).
find_after_declarations() {
    local file="$1"
    local start_line="$2"
    awk -v start="$start_line" '
        NR <= start { next }
        {
            line = $0
            # Trim leading/trailing whitespace for classification
            t = line
            sub(/^[ \t]+/, "", t)
            sub(/[ \t]+$/, "", t)
            if (t == "") next                  # blank line: keep scanning
            if (t ~ /^\/\// || t ~ /^\/\*/) next # full-line comment: keep scanning
            if (t !~ /;$/) { print NR; exit }  # no trailing semicolon => statement
            # Lines ending with ; could be declarations OR statement-expressions
            # (e.g. function call). Heuristic: if the part before the FIRST
            # identifier token (after stripping common leading type keywords)
            # contains a known statement keyword, treat as statement.
            low = tolower(t)
            # Strip common leading type/storage keywords
            while (low ~ /^(const|static|volatile|unsigned|signed|register|inline|extern)[[:space:]]+/) {
                sub(/^(const|static|volatile|unsigned|signed|register|inline|extern)[[:space:]]+/, "", low)
            }
            # Struct/union/enum tag prefix like "struct foo "
            if (low ~ /^(struct|union|enum)[[:space:]]+[a-zA-Z_][a-zA-Z0-9_]*[[:space:]]+/) {
                sub(/^(struct|union|enum)[[:space:]]+[a-zA-Z_][a-zA-Z0-9_]*[[:space:]]+/, "", low)
            }
            # Now low starts with the canonical C type: int, char, long, short,
            # void, float, double, _Bool, bool, u8/u16/u32/u64, s8/..., __u8...,
            # or a custom typedef name (alphabetic). Then comes the variable
            # name (possibly with *). After that comes either = initializer or
            # , or nothing before the ;
            #
            # If low begins with a statement keyword, treat as statement.
            if (low ~ /^(if|for|while|switch|return|goto|do|break|continue)[[:space:]]+/) {
                print NR; exit
            }
            # If the line contains a function-call-like "name(" before any "="
            # after the type, AND the whole line is not a plain
            # "type var;" declaration, treat as statement.
            # Simple detection: if "=" is present with something that does not
            # look like a numeric/string literal/identifier on the RHS, AND the
            # RHS contains "(" we call it a statement-expression.
            # Otherwise: declaration.
            #
            # Conservative rule: if the line ends with ");" and contains "("
            # (a function call) AND the token before "(" is NOT followed by
            # "*" (a pointer-decl), call it a statement.
            if (t ~ /\([^;]*\);$/) {
                # function-call-like; but it could also be a cast/init like
                # struct foo x = (struct foo){...};. Defer: if the RHS after
                # the FIRST identifier+whitespace chunk does NOT contain "=",
                # it is a pure function call statement.
                # Simpler: if no "=" appears in the line, this is a call.
                if (t !~ /=/ ) { print NR; exit }
                # Has "=" -- check whether the LHS before "=" looks like
                # "<type> <varname>" (declaration) vs something else.
                # Crude check: count "=" before any "==" or ">=". If exactly
                # one "=" and the part before is "type var", declaration.
                n_eq = gsub(/=/, "=", line)
                if (n_eq == 1) {
                    # declaration-with-init: type var = expr;
                    next   # keep scanning
                }
                # Multiple "=" or odd pattern -> treat as statement
                print NR; exit
            }
            # Ends with ;, no call-shape, no statement keyword -> declaration
            next
        }
    ' "$file"
}

# parse_function_params FILE START_LINE
#   Given the line where a function signature begins, return the comma-separated
#   list of parameter NAMES (NOT types) on stdout, one per line. Handles the
#   common C styles:
#     static int foo(int a, struct bar *b, int c)
#     int foo(int a,
#             struct bar *b)
#   Multi-line parameter lists are collected until the closing ')'.
#   Pointer/array decorations are stripped so the bare identifier is returned.
parse_function_params() {
    local file="$1"
    local start_line="$2"
    awk -v start="$start_line" '
        BEGIN { collecting = 0; params = ""; depth = 0; is_syscall = 0 }
        NR < start { next }
        {
            line = $0
            if (!collecting) {
                # Detect the SYSCALL_DEFINE<N>(...) macro form, whose parameter
                # list has the shape (name, type1, arg1, type2, arg2, ...) so the
                # real argument names sit at every OTHER position (2nd, 4th, ...).
                if (line ~ /SYSCALL_DEFINE[0-9]+\(/) is_syscall = 1
                p = index(line, "(")
                if (p == 0) next
                rest = substr(line, p + 1)
                collecting = 1
                depth = 1
            } else {
                rest = line
            }
            i = 1
            n = length(rest)
            while (i <= n) {
                c = substr(rest, i, 1)
                if (c == "(") { depth++; params = params c }
                else if (c == ")") {
                    depth--
                    if (depth == 0) {
                        print_params(params, is_syscall)
                        exit
                    } else { params = params c }
                } else {
                    params = params c
                }
                i++
            }
        }
        function print_params(s, syscall,   n, arr, i, p, name, j) {
            n = split(s, arr, ",")
            for (i = 1; i <= n; i++) {
                p = arr[i]
                sub(/^[ \t]*/, "", p)
                sub(/[ \t]*$/, "", p)
                if (syscall) {
                    # Names are every OTHER token (2nd, 4th, 6th, ...) because the
                    # shape is (name, type, arg, type, arg, ...). Skip the first
                    # token (the syscall name) and then take odd positions.
                    if (i == 1) continue
                    if (i % 2 == 1) {
                        name = p
                        gsub(/^\*+/, "", name)
                        if (name != "") print name
                    }
                    continue
                }
                # Normal C function: take the trailing identifier of each segment.
                if (p ~ /[ \t*]/) {
                    j = length(p)
                    while (j > 0 && substr(p, j, 1) != " " && substr(p, j, 1) != "*") j--
                    name = substr(p, j + 1)
                } else { name = p }
                gsub(/\[.*\]/, "", name)
                gsub(/^\*+/, "", name)
                if (name != "") print name
            }
        }
    ' "$file"
}

# func_param_count FILE START_LINE  -> number of params
func_param_count() {
    local file="$1" start_line="$2"
    parse_function_params "$file" "$start_line" | wc -l
}

# func_has_param FILE START_LINE NAME -> 0 if NAME is among the params, 1 if not
func_has_param() {
    local file="$1" start_line="$2" name="$3"
    parse_function_params "$file" "$start_line" | grep -qx "$name"
}

insert_before_line() {
    local file="$1"
    local line_num="$2"
    local content="$3"
    local indent="${4:-}"
    local tmp_file
    tmp_file=$(mktemp)
    printf '%s\n' "$content" > "$tmp_file"
    if [[ $line_num -le 1 ]]; then
        local out_file
        out_file=$(mktemp)
        cat "$tmp_file" "$file" > "$out_file"
        mv "$out_file" "$file"
    else
        sed -i "$((line_num - 1))r $tmp_file" "$file"
    fi
    rm -f "$tmp_file"
}

insert_after_line() {
    local file="$1"
    local line_num="$2"
    local content="$3"
    local indent="${4:-}"
    local tmp_file
    tmp_file=$(mktemp)
    printf '%s\n' "$content" > "$tmp_file"
    sed -i "${line_num}r $tmp_file" "$file"
    rm -f "$tmp_file"
}

# Tries multiple patterns and returns the first matching line number.
# Always returns 0 (empty output if no match) to be safe with set -e.
patch_with_fallback() {
    local file="$1"
    local patterns=("${@:2}")
    local result=""

    for pattern in "${patterns[@]}"; do
        result=$(find_function_start "$file" "$pattern")
        if [[ -n "$result" ]]; then
            echo "$result"
            return 0
        fi
    done
    echo ""
    return 0
}

verify_patch_applied() {
    local file="$1"
    local hook_pattern="$2"
    grep -q "$hook_pattern" "$file"
}

backup_and_verify() {
    local file="$1"

    # If backups are disabled, return success without creating backup
    if [[ $CREATE_BACKUP -eq 0 ]]; then
        log_debug "Backup disabled, skipping backup for $file"
        return 0
    fi

    local backup_pattern="${file}.ksu-backup.*"
    local existing_backup
    existing_backup=$(ls -t ${backup_pattern} 2>/dev/null | head -1)

    if [[ -n "$existing_backup" ]]; then
        log_debug "Using existing backup: $existing_backup"
        echo "$existing_backup"
        return 0
    fi

    local backup
    backup=$(backup_file "$file")
    [[ -f "$backup" ]] || { log_error "Failed to create backup for $file"; return 1; }
    echo "$backup"
    return 0
}

# ============================================================================
# Utility Functions
# ============================================================================
get_backport_list() {
    local list=()
    [[ $BACKPORT_PATH_UMOUNT -eq 1 ]] && list+=("path_umount")
    [[ $BACKPORT_DEVPTS -eq 1 ]] && list+=("devpts")
    [[ $BACKPORT_SAFE_MODE -eq 1 ]] && list+=("safe_mode")
    if [[ ${#list[@]} -eq 0 ]]; then
        echo "none"
    else
        echo "${list[*]}"
    fi
}

show_usage() {
    cat <<EOF
Usage: $SCRIPT_NAME [options] <method> [<kernel_source_dir>] [defconfig_path]
       $SCRIPT_NAME [<kernel_source_dir>] --backport-<name>...

Integrate KernelSU (original/tiann, non-GKI) into a kernel source tree.

Arguments (Full Integration):
  method            Integration method: 'manual' or 'kprobe'
  kernel_source_dir Path to kernel source tree (default: current working directory)
  defconfig_path    Defconfig filename (relative to kernel_source/arch/arm64/configs/ or absolute)

Arguments (Standalone Backport Mode):
  kernel_source_dir Path to kernel source tree (default: current working directory)
  --backport-<name> Apply ONLY the specified backport(s) (no method argument)

Options:
  --skip-ksu-fetch          Skip fetching/updating KernelSU submodule (use existing)
  --skip-patchs             Skip the patch step (manual method patches and --backport-*
                            patches). Only perform initial setup: KernelSU source
                            fetch + symlink/Makefile/Kconfig + defconfig updates.
                            Useful when you want to set up the KSU source tree first
                            and apply patches in a later, separate run.
  --integrate               Instead of creating a symlink at drivers/kernelsu ->
                            external/KernelSU/kernel, COPY the KSU kernel source into
                            the kernel tree as a real directory. Useful for kernel
                            trees that are not part of the lavender repo (standalone
                            builds, vendor kernel trees checked out for one-off
                            compilation) where following a symlink back to a repo
                            that does not exist would break the build. The KSU
                            submodule is still fetched and pinned to the right tag
                            ($KSU_TAG) so the copy contains the correct version;
                            only the integration step (symlink -> copy) changes.
  --backup                  Create backup files before patching kernel source files.
                            By default, NO backup is created. Use this flag if you
                            want .ksu-backup.* files for manual recovery.

Backport Options (work in BOTH modes):
  --backport-path_umount    Backport path_umount from kernel 5.9 → fs/namespace.c
                            Fixes "Umount module" feature on pre-5.9 / pre-GKI kernels
  --backport-devpts         Patch fs/devpts/inode.c → fixes "pm execution failed" in terminal
  --backport-safe-mode      Patch drivers/input/input.c → enables KernelSU Safe Mode
  --backport-all            Apply ALL three backports above

  In FULL INTEGRATION mode (with method argument): backports apply IN ADDITION to normal steps
  In STANDALONE MODE (without method argument): ONLY the specified backport(s) are applied
  Multiple --backport-* flags can be combined (e.g. --backport-devpts --backport-safe-mode)

Methods:
  kprobe   - Uses kprobe hooks (recommended if kprobe works on your kernel)
             Requires: CONFIG_KPROBES, CONFIG_HAVE_KPROBES, CONFIG_KPROBE_EVENTS
  manual   - Direct source code patches (for kernels where kprobe is broken
             or kernel version < 4.8)
             Patches 4 files: fs/exec.c, fs/open.c, fs/read_write.c, fs/stat.c

KernelSU Source:
  Uses external/KernelSU git submodule (main branch, pinned to v0.9.5 tag).
  Submodule is auto-initialized on first run. Subsequent runs update it.
  Last supported version for non-GKI: v0.9.5 (v1.0+ dropped non-GKI support).

Important:
  - If using manual integration, you MUST disable CONFIG_KPROBES in defconfig
    to prevent accidental Safe Mode triggers (volume down button after boot).
  - For kernels < 5.9, use --backport-path_umount to enable "Umount module" feature.
  - For kernels < 4.17, the script automatically falls back from do_faccessat to
    SYSCALL_DEFINE3(faccessat), and from vfs_statx to vfs_fstatat.

Examples:
  # Full integration (kernel source = current directory)
  $SCRIPT_NAME kprobe vendor/lavender_defconfig
  $SCRIPT_NAME manual lavender_defconfig
  $SCRIPT_NAME --skip-ksu-fetch manual vendor/lavender-perf_defconfig

  # Full integration with explicit kernel source
  $SCRIPT_NAME kprobe /path/to/kernel vendor/lavender_defconfig
  $SCRIPT_NAME manual /path/to/kernel lavender_defconfig

  # Setup only - fetch KSU source + update defconfig, skip patches (manual method)
  $SCRIPT_NAME --skip-patchs manual lavender_defconfig
  $SCRIPT_NAME --skip-patchs kprobe /path/to/kernel vendor/lavender_defconfig

  # Full integration but COPY KernelSU source into the kernel tree instead of
  # symlinking it. Use this for kernel trees that live outside the lavender repo.
  $SCRIPT_NAME --integrate manual lavender_defconfig
  $SCRIPT_NAME --integrate kprobe /path/to/standalone/kernel lavender_defconfig

  # Setup only with explicit kernel source + backports skipped
  $SCRIPT_NAME --skip-patchs --backport-devpts manual vendor/lavender_defconfig
  # ^ will set up KSU source + defconfig, but skip the devpts backport patch

  # Full integration WITH backports (pre-5.9 kernels)
  $SCRIPT_NAME manual --backport-path_umount lavender_defconfig
  $SCRIPT_NAME kprobe /path/to/kernel vendor/lavender_defconfig --backport-path_umount --backport-devpts

  # Standalone: only apply backport(s) (no defconfig needed, no method argument)
  $SCRIPT_NAME --backport-path_umount
  $SCRIPT_NAME /path/to/kernel --backport-devpts --backport-safe-mode
  $SCRIPT_NAME --backport-all

Notes:
  - Kernel source must be buildable (bootable kernel from source)
  - For manual method: patches 4 kernel files with KSU hooks
  - For kprobe method: enables required kprobe configs in defconfig
  - --backport-* in full integration = adds backports to normal steps
  - --backport-* without method = standalone mode (only specified backports)
  - Run from kernel source root or provide absolute paths
EOF
}

validate_args() {
    [[ $# -ge 1 ]] || { show_usage; die "Expected at least 1 argument, got $#"; }

    # Parse all args to identify flags and positional args
    local args=()
    local has_backport_path_umount=0
    local has_backport_devpts=0
    local has_backport_safe_mode=0
    local has_backport_all=0
    
    for arg in "$@"; do
        case "$arg" in
            --skip-ksu-fetch) SKIP_KSU_FETCH=1 ;;
            --skip-patchs) SKIP_PATCHES=1 ;;
            --integrate) INTEGRATE_COPY=1 ;;
            --backup) CREATE_BACKUP=1 ;;
            --backport-path_umount) has_backport_path_umount=1 ;;
            --backport-devpts) has_backport_devpts=1 ;;
            --backport-safe_mode|--backport-safe-mode) has_backport_safe_mode=1 ;;
            --backport-all) has_backport_all=1 ;;
            *) args+=("$arg") ;;
        esac
    done

    # If --backport-all is set, enable all individual backports
    if [[ $has_backport_all -eq 1 ]]; then
        has_backport_path_umount=1
        has_backport_devpts=1
        has_backport_safe_mode=1
    fi

    BACKPORT_PATH_UMOUNT=$has_backport_path_umount
    BACKPORT_DEVPTS=$has_backport_devpts
    BACKPORT_SAFE_MODE=$has_backport_safe_mode
    BACKPORT_ALL=$has_backport_all

    # Check if any backport flag is set
    if [[ $BACKPORT_PATH_UMOUNT -eq 1 || $BACKPORT_DEVPTS -eq 1 || $BACKPORT_SAFE_MODE -eq 1 ]]; then
        ANY_BACKPORT_SET=1
    else
        ANY_BACKPORT_SET=0
    fi

    # Determine if first positional arg is a method (manual/kprobe) or a kernel directory
    local first_arg="${args[0]:-}"
    local is_method=0
    [[ "$first_arg" == "manual" || "$first_arg" == "kprobe" ]] && is_method=1

    if [[ $is_method -eq 1 ]]; then
        # Full integration mode: method [kernel_source_dir] defconfig_path
        METHOD="$first_arg"

        # Check if second arg is a directory (explicit kernel source)
        if [[ ${#args[@]} -ge 2 && -d "${args[1]}" ]]; then
            KERNEL_SRC="$(realpath "${args[1]}")"
            DEFCONFIG_ARG_INDEX=2
        else
            KERNEL_SRC="$(realpath ".")"
            DEFCONFIG_ARG_INDEX=1
        fi

        [[ -d "$KERNEL_SRC" ]] || die "Kernel source directory not found: $KERNEL_SRC"
        [[ -w "$KERNEL_SRC" ]] || die "Kernel source directory not writable: $KERNEL_SRC"

        # Defconfig is required in full integration mode
        if [[ ${#args[@]} -le $DEFCONFIG_ARG_INDEX ]]; then
            die "Defconfig path is required in full integration mode"
        fi

        local defconfig_input="${args[$DEFCONFIG_ARG_INDEX]}"
        if [[ "$defconfig_input" = /* ]]; then
            DEFCONFIG_PATH="$defconfig_input"
        else
            DEFCONFIG_PATH="$KERNEL_SRC/arch/arm64/configs/$defconfig_input"
        fi

        [[ -f "$DEFCONFIG_PATH" ]] || die "Defconfig not found: $DEFCONFIG_PATH"
        [[ -w "$DEFCONFIG_PATH" ]] || die "Defconfig not writable: $DEFCONFIG_PATH"

        if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
            log_info "Full integration mode with backport(s) enabled: $(get_backport_list)"
        fi

    else
        # Standalone backport mode: [kernel_source_dir] --backport-*
        [[ $ANY_BACKPORT_SET -eq 1 ]] || die "Standalone backport mode requires at least one --backport-* flag"

        METHOD="standalone"

        # Check if first arg is a directory (explicit kernel source)
        if [[ ${#args[@]} -ge 1 && -d "${args[0]}" ]]; then
            KERNEL_SRC="$(realpath "${args[0]}")"
        else
            KERNEL_SRC="$(realpath ".")"
        fi

        [[ -d "$KERNEL_SRC" ]] || die "Kernel source directory not found: $KERNEL_SRC"
        [[ -w "$KERNEL_SRC" ]] || die "Kernel source directory not writable: $KERNEL_SRC"

        # Verify target backport files exist for standalone mode
        if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE" ]] \
                || die "namespace.c not found: $KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE"
        fi
        if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_DEVPTS_FILE" ]] \
                || die "devpts/inode.c not found: $KERNEL_SRC/$BACKPORT_DEVPTS_FILE"
        fi
        if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE" ]] \
                || die "input.c not found: $KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE"
        fi

        DEFCONFIG_PATH=""
        log_info "Standalone backport mode"
        log_info "  Backports to apply: $(get_backport_list)"
        log_info "  Skipping: KSU source fetch, manual patches, defconfig updates"
    fi

    log_debug "Method: $METHOD"
    log_debug "Kernel source: $KERNEL_SRC"
    log_debug "Defconfig: ${DEFCONFIG_PATH:-<none>}"
    log_debug "Skip KSU fetch: $SKIP_KSU_FETCH"
    log_debug "Skip patches: $SKIP_PATCHES"
    log_debug "Integrate (copy vs symlink): $INTEGRATE_COPY"
    log_debug "Create backup: $CREATE_BACKUP"
    log_debug "Backport path_umount: $BACKPORT_PATH_UMOUNT"
    log_debug "Backport devpts: $BACKPORT_DEVPTS"
    log_debug "Backport safe_mode: $BACKPORT_SAFE_MODE"
    log_debug "Any backport set: $ANY_BACKPORT_SET"
}

# ============================================================================
# Pre-flight Checks & Backup
# ============================================================================
check_prerequisites() {
    log_step "Checking prerequisites"

    local missing=()
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        # Standalone backport mode: only need text-processing tools
        for cmd in grep sed awk find; do
            command -v "$cmd" >/dev/null || missing+=("$cmd")
        done
    else
        # Full integration: need all tools including git for submodule
        for cmd in git make grep sed awk find; do
            command -v "$cmd" >/dev/null || missing+=("$cmd")
        done
    fi

    [[ ${#missing[@]} -eq 0 ]] || die "Missing required commands: ${missing[*]}"

    # Verify it's a kernel source tree
    [[ -f "$KERNEL_SRC/Makefile" && -f "$KERNEL_SRC/Kconfig" ]] \
        || die "Not a valid kernel source tree: $KERNEL_SRC"

    # KernelSU's Kconfig declares `depends on OVERLAY_FS`. If this kernel
    # doesn't even have the OVERLAY_FS Kconfig symbol, we can't satisfy that
    # dependency — warn the user loudly before they spend time building.
    if [[ $ANY_BACKPORT_SET -eq 0 ]]; then
        if ! grep -rq '^config OVERLAY_FS\b' "$KERNEL_SRC/fs/overlayfs/Kconfig" 2>/dev/null; then
            log_warn "This kernel has no CONFIG_OVERLAY_FS Kconfig symbol (fs/overlayfs/Kconfig missing or empty)."
            log_warn "KernelSU requires CONFIG_OVERLAY_FS=y. The KSU build will silently fail."
            log_warn "Either: (a) enable OVERLAY_FS in your kernel source, or (b) patch the copied KSU Kconfig to remove 'depends on OVERLAY_FS'."
        fi
    fi

    # In standalone mode, verify target backport files exist
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE" ]] \
                || die "namespace.c not found: $KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE"
        fi
        if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_DEVPTS_FILE" ]] \
                || die "devpts/inode.c not found: $KERNEL_SRC/$BACKPORT_DEVPTS_FILE"
        fi
        if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE" ]] \
                || die "input.c not found: $KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE"
        fi
    fi

    log_success "Prerequisites satisfied"
}

backup_file() {
    local file="$1"
    local backup="${file}.ksu-backup.$(date +%Y%m%d_%H%M%S)"
    cp -p "$file" "$backup"
    log_debug "Backed up $file to $backup"
    echo "$backup"
}

restore_backup() {
    local file="$1"

    # If backups are disabled, nothing to restore
    if [[ $CREATE_BACKUP -eq 0 ]]; then
        log_debug "Backup disabled, skipping restore for $file"
        return 0
    fi

    local backup_pattern="${file}.ksu-backup.*"
    local latest_backup
    latest_backup=$(ls -t ${backup_pattern} 2>/dev/null | head -1)
    if [[ -n "$latest_backup" && -f "$latest_backup" ]]; then
        cp -p "$latest_backup" "$file"
        log_warn "Restored $file from backup: $latest_backup"
    fi
}

# ============================================================================
# Pre-flight Detection
# ============================================================================
detect_existing_ksu() {
    log_step "Detecting existing KernelSU integration"

    local has_ksu_source=0
    local has_manual_patches=0
    local has_kprobe_configs=0
    local has_ksu_config=0
    local manual_patched_files=()
    local kprobe_configs_found=()
    local kprobe_configs_missing=()

    # Find drivers directory
    local driver_dir
    if [[ -d "$KERNEL_SRC/common/drivers" ]]; then
        driver_dir="common/drivers"
    elif [[ -d "$KERNEL_SRC/drivers" ]]; then
        driver_dir="drivers"
    else
        driver_dir="drivers"
    fi

    # Check KernelSU source (submodule) and symlink in kernel tree
    if [[ -d "$KSU_KERNEL_SOURCE" ]] && [[ -L "$KERNEL_SRC/$driver_dir/kernelsu" ]]; then
        has_ksu_source=1
        log_info "KernelSU source detected: $KSU_KERNEL_SOURCE (symlinked in $driver_dir/kernelsu)"
    fi

    # Check manual patches in kernel source (4 files for KSU original)
    for file in "${MANUAL_PATCH_FILES[@]}"; do
        local filepath="$KERNEL_SRC/$file"
        if [[ -f "$filepath" ]] && grep -q "ksu_handle_" "$filepath"; then
            manual_patched_files+=("$file")
            has_manual_patches=1
        fi
    done

    if [[ ${#manual_patched_files[@]} -gt 0 ]]; then
        log_info "Manual patches detected in: ${manual_patched_files[*]}"
    fi

    # Check defconfig for KSU config
    if grep -q "^CONFIG_KSU=y" "$DEFCONFIG_PATH"; then
        has_ksu_config=1
        log_info "CONFIG_KSU=y found in defconfig"
    fi

    # Check defconfig for kprobe configs
    for config in "${KPROBE_CONFIGS[@]}"; do
        local key="${config%%=*}"
        if grep -q "^${key}=y" "$DEFCONFIG_PATH"; then
            kprobe_configs_found+=("$key")
            has_kprobe_configs=1
        else
            kprobe_configs_missing+=("$key")
        fi
    done

    if [[ ${#kprobe_configs_found[@]} -gt 0 ]]; then
        log_info "Kprobe configs enabled: ${kprobe_configs_found[*]}"
    fi
    if [[ ${#kprobe_configs_missing[@]} -gt 0 ]]; then
        log_debug "Kprobe configs not set: ${kprobe_configs_missing[*]}"
    fi

    # Determine existing integration method
    local existing_method="none"
    if [[ $has_manual_patches -eq 1 && $has_kprobe_configs -eq 1 ]]; then
        existing_method="both (hybrid)"
        log_warn "Hybrid integration detected: manual patches + kprobe configs both present"
    elif [[ $has_manual_patches -eq 1 ]]; then
        existing_method="manual"
        log_info "Existing integration method: manual patches"
    elif [[ $has_kprobe_configs -eq 1 && $has_ksu_config -eq 1 ]]; then
        existing_method="kprobe"
        log_info "Existing integration method: kprobe"
    elif [[ $has_ksu_source -eq 1 ]]; then
        existing_method="source-only"
        log_info "KernelSU source present but no integration detected"
    fi

    # Warn if switching methods
    if [[ "$existing_method" != "none" && "$existing_method" != "source-only" ]]; then
        if [[ "$METHOD" == "manual" && "$existing_method" == "kprobe" ]]; then
            log_warn "Switching from kprobe to manual method"
            log_info "  - Kprobe configs will be disabled"
            log_info "  - Manual patches will be applied/verified on 4 kernel files"
        elif [[ "$METHOD" == "kprobe" && "$existing_method" == "manual" ]]; then
            log_warn "Switching from manual to kprobe method"
            log_info "  - Manual patches will remain in source (harmless but unused)"
            log_info "  - Kprobe configs will be enabled"
        fi
    fi

    export KSU_EXISTING_METHOD="$existing_method"
}

# ============================================================================
# KernelSU Source Integration (using external submodule)
# ============================================================================
fetch_ksu_source() {
    log_step "Setting up KernelSU from submodule (branch: $KSU_BRANCH, tag: $KSU_TAG)"

    # Ensure submodule exists and is initialized
    if [[ ! -d "$KSU_SUBMODULE_PATH/.git" && ! -f "$KSU_SUBMODULE_PATH/.git" ]]; then
        if [[ $SKIP_KSU_FETCH -eq 1 ]]; then
            die "KernelSU submodule not initialized at $KSU_SUBMODULE_PATH and --skip-ksu-fetch specified. Run 'git submodule update --init external/KernelSU' first."
        fi
        log_info "Initializing KernelSU submodule..."
        git -C "$LAVENDER_ROOT" submodule update --init --recursive external/KernelSU
    fi

    # Ensure we're on the main branch first
    local current_branch
    current_branch=$(git -C "$KSU_SUBMODULE_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    if [[ "$current_branch" != "$KSU_BRANCH" && "$current_branch" != "(HEAD detached at $KSU_TAG)" ]]; then
        if [[ "$current_branch" == "HEAD" ]]; then
            log_info "Submodule in detached HEAD state, switching to $KSU_BRANCH..."
        else
            log_info "Switching KernelSU to '$KSU_BRANCH' branch..."
        fi
        git -C "$KSU_SUBMODULE_PATH" checkout "$KSU_BRANCH" 2>/dev/null || \
            die "Failed to checkout '$KSU_BRANCH' branch in submodule"
    fi

    # Optionally update submodule (unless skipped)
    if [[ $SKIP_KSU_FETCH -eq 0 ]]; then
        log_info "Updating KernelSU submodule..."
        git -C "$KSU_SUBMODULE_PATH" stash 2>/dev/null || true
        git -C "$KSU_SUBMODULE_PATH" fetch origin 2>/dev/null || log_warn "Git fetch failed (network issue?), continuing with existing source"
        git -C "$KSU_SUBMODULE_PATH" pull origin "$KSU_BRANCH" 2>/dev/null || true
    else
        log_info "Skipping submodule update (--skip-ksu-fetch specified)"
    fi

    # Checkout the pinned tag (v0.9.5 - last non-GKI supported version)
    log_info "Checking out tag $KSU_TAG (last non-GKI supported version)..."
    git -C "$KSU_SUBMODULE_PATH" checkout "$KSU_TAG" 2>/dev/null || \
        log_warn "Failed to checkout $KSU_TAG tag. Ensure it exists: git -C $KSU_SUBMODULE_PATH fetch --tags"

    # Verify KernelSU source structure
    [[ -d "$KSU_KERNEL_SOURCE" ]] || die "KernelSU kernel source not found at $KSU_KERNEL_SOURCE"
    [[ -f "$KSU_KERNEL_SOURCE/Kconfig" ]] || die "KernelSU source incomplete - Kconfig missing"
    # KernelSU original (v0.9.5) uses core_hook.c, not core/init.c
    [[ -f "$KSU_KERNEL_SOURCE/core_hook.c" ]] || die "KernelSU source incomplete - core_hook.c missing"
    [[ -f "$KSU_KERNEL_SOURCE/ksu.c" ]] || die "KernelSU source incomplete - ksu.c missing"

    # Integrate into kernel source: symlink, Makefile, Kconfig
    integrate_ksu_into_kernel

    log_success "KernelSU source integrated from submodule (tag: $KSU_TAG)"
}

# Integrate KernelSU into kernel source tree (replaces setup.sh logic)
integrate_ksu_into_kernel() {
    log_step "Integrating KernelSU into kernel source tree"

    cd "$KERNEL_SRC"

    # Find drivers directory (GKI: common/drivers, traditional: drivers)
    local driver_dir
    if [[ -d "common/drivers" ]]; then
        driver_dir="common/drivers"
    elif [[ -d "drivers" ]]; then
        driver_dir="drivers"
    else
        die "Could not find drivers/ directory in kernel source"
    fi

    local driver_makefile="$driver_dir/Makefile"
    local driver_kconfig="$driver_dir/Kconfig"
    local kernelsu_symlink="$driver_dir/kernelsu"

    # Compute relative path from driver_dir to KernelSU kernel source (used for
    # the symlink fallback). With --integrate we copy instead of linking, so
    # this is only relevant when INTEGRATE_COPY=0.
    local rel_path
    rel_path=$(realpath --relative-to="$(pwd)/$driver_dir" "$KSU_KERNEL_SOURCE")

    # 1. Create/update integration: symlink by default, real directory copy with
    #    --integrate. The copy is a self-contained snapshot of $KSU_KERNEL_SOURCE
    #    (the submodule, already pinned to $KSU_TAG) so the kernel tree does not
    #    need external/KernelSU to exist at build time. We never silently
    #    overwrite a non-empty directory we did not create: a marker file
    #    (.ksu-integrated-copy) marks our own previous copies.
    local ks_marker="$kernelsu_symlink/.ksu-integrated-copy"
    if [[ $INTEGRATE_COPY -eq 1 ]]; then
        # ---- copy mode ----
        if [[ -L "$kernelsu_symlink" ]]; then
            # Existing symlink (e.g. left over from a previous non-integrate run):
            # remove it and replace with a real copy.
            local old_target
            old_target=$(readlink "$kernelsu_symlink")
            log_info "Replacing existing symlink with copy (was -> $old_target)"
            rm -f "$kernelsu_symlink"
        elif [[ -d "$kernelsu_symlink" ]]; then
            # Real directory. Refresh if it is one of our copies (marker present);
            # refuse otherwise to protect unrelated content.
            if [[ -f "$ks_marker" ]]; then
                log_info "Refreshing previous KSU copy at $kernelsu_symlink"
                rm -rf "$kernelsu_symlink"
            else
                die "$kernelsu_symlink already exists as a directory and is NOT a previous KSU copy (no .ksu-integrated-copy marker). Remove it manually or rename it to use --integrate."
            fi
        fi

        log_info "Copying KSU source into kernel tree ($kernelsu_symlink)"
        # cp -a preserves attributes/ownership; --no-target-directory forces the
        # destination to be treated as a directory even if the source has the
        # same basename. We exclude the source's own .git directory if any
        # (KernelSU kernel/ has none, but be defensive).
        mkdir -p "$kernelsu_symlink"
        cp -a "$KSU_KERNEL_SOURCE/." "$kernelsu_symlink/"
        # Remove any git/submodule leftovers that might leak in (KernelSU
        # kernel/ is plain C source, but the parent external/KernelSU is a git
        # worktree, so any .git pointer would break the standalone build).
        rm -rf "$kernelsu_symlink/.git"

        # ---- Standalone-build fix: KSU_GIT_VERSION ----
        # The KSU Makefile computes KSU_GIT_VERSION from `git rev-list --count HEAD`
        # inside the source tree. In the symlink case that works because the build
        # follows the symlink into external/KernelSU/ (a real git repo). In the
        # --integrate/copy case the copy is not a git repo and there is no upstream
        # override escape hatch, so the Makefile falls back to KSU_VERSION=16 and
        # emits the warning "KSU_GIT_VERSION not defined! It is better to make
        # KernelSU a git submodule!". Since the user explicitly does NOT want the
        # submodule modified and the copied tree is not a repo, we patch the copied
        # Makefile to hardcode the version computed from the submodule we just
        # copied FROM (preserves the correct version, silences the warning, leaves
        # the submodule untouched).
        local ksu_makefile="$kernelsu_symlink/Makefile"
        local ksu_count ksu_version
        ksu_count=$(git -C "$KSU_SUBMODULE_PATH" rev-list --count HEAD 2>/dev/null || echo "")
        if [[ -n "$ksu_count" && -f "$ksu_makefile" ]]; then
            ksu_version=$((ksu_count + 10200))   # upstream formula: 10000 + count + 200
            log_info "Patching copied KSU Makefile with hardcoded KSU_GIT_VERSION=$ksu_count (KSU_VERSION=$ksu_version)"
            # Replace lines 19-30 (the ifeq/else/end block) with a clean hardcoded version.
            # We do the replacement with awk to be robust to whitespace variations.
            local tmp_mk
            tmp_mk=$(mktemp)
            awk -v count="$ksu_count" -v ver="$ksu_version" '
                BEGIN { replaced = 0 }
                # Match the start of the .git-detection block (the comment line)
                /^# \.git is a text file while the module is imported by/ && !replaced {
                    print "# Auto-generated by ksu-install --integrate: KSU_GIT_VERSION"
                    print "# hardcoded because the kernel tree is standalone (no"
                    print "# upstream escape hatch exists for non-submodule builds)."
                    print "KSU_GIT_VERSION := " count
                    print "KSU_VERSION := " ver
                    print "$(info -- KernelSU version: $(KSU_VERSION))"
                    print "ccflags-y += -DKSU_VERSION=$(KSU_VERSION)"
                    replaced = 1
                    # Skip until the matching "endif" of this block
                    skip = 1
                    next
                }
                skip && /^endif$/ { skip = 0; next }
                skip { next }
                { print }
            ' "$ksu_makefile" > "$tmp_mk"
            mv "$tmp_mk" "$ksu_makefile"
            log_info "KSU Makefile patched (submodule left untouched)"
        else
            log_warn "Could not compute KSU_GIT_VERSION from submodule (count='$ksu_count'). Copy may build with fallback KSU_VERSION=16."
        fi

        # Drop the marker so we can detect this directory on later runs.
        echo "Copied from $KSU_KERNEL_SOURCE at $(date -u +%FT%TZ)  KSU_VERSION=$ksu_version" > "$ks_marker"
        log_info "KSU copy complete; marker written to $ks_marker"
    else
        # ---- symlink mode (default, unchanged behaviour) ----
        if [[ -L "$kernelsu_symlink" ]]; then
            local current_target
            current_target=$(readlink "$kernelsu_symlink")
            if [[ "$current_target" != "$rel_path" ]]; then
                log_info "Updating kernelsu symlink: $current_target -> $rel_path"
                rm "$kernelsu_symlink"
                ln -sf "$rel_path" "$kernelsu_symlink"
            else
                log_debug "kernelsu symlink already correct"
            fi
        elif [[ -e "$kernelsu_symlink" ]]; then
            die "$kernelsu_symlink exists but is not a symlink. Remove it manually first."
        else
            log_info "Creating kernelsu symlink -> $rel_path"
            ln -sf "$rel_path" "$kernelsu_symlink"
        fi
    fi

    # 2. Update drivers/Makefile: add obj-$(CONFIG_KSU) += kernelsu/
    if grep -q "kernelsu" "$driver_makefile"; then
        log_debug "Makefile already has kernelsu entry"
    else
        log_info "Adding kernelsu to $driver_makefile"
        printf "\nobj-\$(CONFIG_KSU) += kernelsu/\n" >> "$driver_makefile"
    fi

    # 3. Update drivers/Kconfig: add source "drivers/kernelsu/Kconfig" before endmenu
    if grep -q 'source "drivers/kernelsu/Kconfig"' "$driver_kconfig"; then
        log_debug "Kconfig already has kernelsu entry"
    else
        log_info "Adding kernelsu to $driver_kconfig"
        local tmp_kconfig
        tmp_kconfig=$(mktemp)
        awk '/^endmenu/ && !done { print "source \"drivers/kernelsu/Kconfig\""; done=1 } { print }' "$driver_kconfig" > "$tmp_kconfig"
        mv "$tmp_kconfig" "$driver_kconfig"
    fi

    log_success "KernelSU integrated into kernel source ($driver_dir)"
}

# ============================================================================
# Defconfig Management
# ============================================================================
update_defconfig() {
    local configs=("$@")
    log_step "Updating defconfig: $(basename "$DEFCONFIG_PATH")"

    local backup
    if [[ $CREATE_BACKUP -eq 1 ]]; then
        backup=$(backup_file "$DEFCONFIG_PATH")
    else
        log_debug "Backup disabled, skipping defconfig backup"
    fi

    local modified=0
    for config in "${configs[@]}"; do
        local key="${config%%=*}"
        local value="${config#*=}"

        if grep -q "^${key}=" "$DEFCONFIG_PATH"; then
            local current
            current=$(grep "^${key}=" "$DEFCONFIG_PATH" | head -1 | cut -d= -f2-)
            if [[ "$current" != "$value" ]]; then
                log_info "Updating $key: $current -> $value"
                if [[ "$value" == "n" ]]; then
                    sed -i "s|^${key}=.*|# ${key} is not set|" "$DEFCONFIG_PATH"
                else
                    sed -i "s|^${key}=.*|${config}|" "$DEFCONFIG_PATH"
                fi
                modified=1
            else
                log_debug "$key already set to $value"
            fi
        elif grep -q "^# ${key} is not set" "$DEFCONFIG_PATH"; then
            if [[ "$value" == "n" ]]; then
                log_debug "$key already disabled"
            else
                log_info "Enabling $key (was disabled)"
                sed -i "s|^# ${key} is not set|${config}|" "$DEFCONFIG_PATH"
                modified=1
            fi
        else
            if [[ "$value" == "n" ]]; then
                log_info "Disabling $key (adding # $key is not set)"
                echo "# ${key} is not set" >> "$DEFCONFIG_PATH"
            else
                log_info "Adding $config"
                echo "$config" >> "$DEFCONFIG_PATH"
            fi
            modified=1
        fi
    done

    # Also ensure CONFIG_KSU is set for both methods
    if ! grep -q "^CONFIG_KSU=" "$DEFCONFIG_PATH" && ! grep -q "^# CONFIG_KSU is not set" "$DEFCONFIG_PATH"; then
        echo "CONFIG_KSU=y" >> "$DEFCONFIG_PATH"
        modified=1
    elif grep -q "^# CONFIG_KSU is not set" "$DEFCONFIG_PATH"; then
        sed -i "s|^# CONFIG_KSU is not set|CONFIG_KSU=y|" "$DEFCONFIG_PATH"
        modified=1
    fi

    if [[ $modified -eq 1 ]]; then
        log_success "Defconfig updated"
    else
        log_info "Defconfig already has required configs"
    fi
}

# ============================================================================
# Manual Method - Patch Application
# ============================================================================
apply_manual_patches() {
    log_step "Applying manual integration patches (KernelSU original: 4 files)"

    local patched_files=()
    local failed_files=()

    for file in "${MANUAL_PATCH_FILES[@]}"; do
        local filepath="$KERNEL_SRC/$file"
        [[ -f "$filepath" ]] || { failed_files+=("$file (not found)"); continue; }

        log_info "Patching $file..."
        if patch_file_manual "$filepath"; then
            patched_files+=("$file")
            log_success "Patched $file"
        else
            failed_files+=("$file (patch failed)")
            log_error "Failed to patch $file"
        fi
    done

    if [[ ${#failed_files[@]} -gt 0 ]]; then
        log_error "Failed to patch: ${failed_files[*]}"
        # Restore backups on failure
        for file in "${patched_files[@]}"; do
            restore_backup "$KERNEL_SRC/$file"
        done
        die "Manual patching failed. Backups restored."
    fi

    log_success "All manual patches applied successfully (${#patched_files[@]} files)"
}

patch_file_manual() {
    local filepath="$1"
    local filename
    filename="$(basename "$filepath")"

    case "$filename" in
        exec.c)
            patch_exec_c "$filepath"
            ;;
        open.c)
            patch_open_c "$filepath"
            ;;
        read_write.c)
            patch_read_write_c "$filepath"
            ;;
        stat.c)
            patch_stat_c "$filepath"
            ;;
        *)
            die "Unknown patch target: $filename"
            ;;
    esac
}

# --- Patch: fs/exec.c ---
# KernelSU original: hooks do_execveat_common with dual hook (execveat + sucompat)
#
# Robustness: we parse the ACTUAL parameter names of do_execveat_common from the
# source (they are not always fd/filename/argv/envp/flags across kernels) and use
# those in the hook call. We also insert the call at the top of do_execveat_common's
# body so every parameter is guaranteed to be in scope (the previous version
# matched a "return do_execveat_common(...)" line that belonged to a *different*
# function, e.g. do_execve, whose parameters did not include fd/flags -> undeclared
# variable compile error). The hook is only emitted if all five expected
# parameters exist in the signature; otherwise we fail loudly rather than emit
# code referencing nonexistent variables.
patch_exec_c() {
    local file="$1"

    if verify_patch_applied "$file" "ksu_handle_execveat"; then
        log_debug "exec.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find do_execveat_common function - try multiple patterns (kernels name it
    # differently across versions: do_execveat_common, __do_execveat_common,
    # do_execve_file, __do_execve_file).
    local execveat_line
    execveat_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+do_execveat_common[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+do_execveat_common[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+__do_execveat_common[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+__do_execveat_common[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+do_execve_file[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+do_execve_file[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+__do_execve_file[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+__do_execve_file[[:space:]]*[(]'
    )
    [[ -n "$execveat_line" ]] || { log_error "Could not find do_execveat_common in $file"; return 1; }

    # Parse the real parameter names of do_execveat_common.
    local params
    params=$(parse_function_params "$file" "$execveat_line")
    local p_fd p_filename p_argv p_envp p_flags
    p_fd=$(printf '%s\n' "$params" | sed -n '1p')
    p_filename=$(printf '%s\n' "$params" | sed -n '2p')
    p_argv=$(printf '%s\n' "$params" | sed -n '3p')
    p_envp=$(printf '%s\n' "$params" | sed -n '4p')
    p_flags=$(printf '%s\n' "$params" | sed -n '5p')

    if [[ -z "$p_fd" || -z "$p_filename" || -z "$p_argv" || -z "$p_envp" || -z "$p_flags" ]]; then
        log_error "do_execveat_common in $file does not have the expected 5 parameters (got: $(echo "$params" | tr '\n' ' '))"
        return 1
    fi

    # Add extern declarations before do_execveat_common
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern bool ksu_execveat_hook __read_mostly;
${indent}extern int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
${indent}                       void *envp, int *flags);
${indent}extern int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
${indent}                                void *argv, void *envp, int *flags);
${indent}#endif"
    insert_before_line "$file" "$execveat_line" "$extern_decl"

    # Insert the hook call at the first executable statement of
    # do_execveat_common (after all local declarations), so all five parameters
    # are in scope AND the placement does not violate
    # -Werror,-Wdeclaration-after-statement under clang. Naively placing the
    # hook right after the opening brace would fail to compile on kernels built
    # with clang when the function declares local variables immediately after
    # the brace.
    local brace_line
    brace_line=$(find_function_end "$file" "$execveat_line" '[{]')
    [[ -n "$brace_line" ]] || { log_error "Could not find opening brace of do_execveat_common"; return 1; }

    local first_stmt_line
    first_stmt_line=$(find_after_declarations "$file" "$brace_line")
    [[ -n "$first_stmt_line" ]] || first_stmt_line=$((brace_line + 1))

    local body_indent
    body_indent=$(detect_indent "$file" "$brace_line")

    # Dual hook: ksu_handle_execveat OR ksu_handle_execveat_sucompat, using the
    # ACTUAL parameter names parsed from the function signature.
    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    if (unlikely(ksu_execveat_hook))
${body_indent}        ksu_handle_execveat(&$p_fd, &$p_filename, &$p_argv, &$p_envp, &$p_flags);
${body_indent}    else
${body_indent}        ksu_handle_execveat_sucompat(&$p_fd, &$p_filename, &$p_argv, &$p_envp, &$p_flags);
${body_indent}#endif"
    insert_before_line "$file" "$first_stmt_line" "$hook_call"

    verify_patch_applied "$file" "ksu_handle_execveat" || { log_error "Patch verification failed for exec.c"; return 1; }

    return 0
}

# --- Patch: fs/open.c ---
# KernelSU original: hooks do_faccessat (or SYSCALL_DEFINE3(faccessat) for kernel < 4.17)
#
# Robustness: parse the ACTUAL parameter names of the located function (they vary
# across kernels) and use them in the hook call instead of hardcoding
# dfd/filename/mode. The hook is only emitted if the expected parameters exist.
patch_open_c() {
    local file="$1"

    if verify_patch_applied "$file" "ksu_handle_faccessat"; then
        log_debug "open.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Try do_faccessat first (kernel >= 4.17), then fall back to SYSCALL_DEFINE3(faccessat) (< 4.17)
    local faccessat_line
    faccessat_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*long[[:space:]]+do_faccessat[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+do_faccessat[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+long[[:space:]]+do_faccessat[[:space:]]*[(]' \
        '^[[:space:]]*asmlinkage[[:space:]]+long[[:space:]]+do_faccessat[[:space:]]*[(]' \
        '^[[:space:]]*SYSCALL_DEFINE3[[:space:]]*[(][[:space:]]*faccessat'
    )
    [[ -n "$faccessat_line" ]] || { log_error "Could not find do_faccessat/faccessat syscall in $file"; return 1; }

    # Parse the real parameter names. Expected shape:
    #   do_faccessat(int dfd, const char __user *filename, int mode[, int flags])
    # We need dfd (1st), filename (2nd), mode (3rd).
    local params
    params=$(parse_function_params "$file" "$faccessat_line")
    local p_dfd p_filename p_mode
    p_dfd=$(printf '%s\n' "$params" | sed -n '1p')
    p_filename=$(printf '%s\n' "$params" | sed -n '2p')
    p_mode=$(printf '%s\n' "$params" | sed -n '3p')
    if [[ -z "$p_dfd" || -z "$p_filename" || -z "$p_mode" ]]; then
        log_error "do_faccessat in $file does not have the expected parameters (got: $(echo "$params" | tr '\n' ' '))"
        return 1
    fi

    # Add extern declaration before the function
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern int ksu_handle_faccessat(int *dfd, const char __user **filename_user, int *mode,
${indent}                        int *flags);
${indent}#endif"
    insert_before_line "$file" "$faccessat_line" "$extern_decl"

    # Insert the hook call at the first executable statement of the function
    # body (after all local declarations), so all parameters are in scope AND
    # the placement does not violate -Werror,-Wdeclaration-after-statement
    # under clang. Naively placing the hook right after the opening brace
    # would fail to compile on kernels built with clang when the function
    # declares local variables immediately after the brace.
    local brace_line
    brace_line=$(find_function_end "$file" "$faccessat_line" '[{]')
    [[ -n "$brace_line" ]] || { log_error "Could not find opening brace of do_faccessat"; return 1; }

    local first_stmt_line
    first_stmt_line=$(find_after_declarations "$file" "$brace_line")
    [[ -n "$first_stmt_line" ]] || first_stmt_line=$((brace_line + 1))

    local body_indent
    body_indent=$(detect_indent "$file" "$brace_line")

    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    ksu_handle_faccessat(&$p_dfd, &$p_filename, &$p_mode, NULL);
${body_indent}#endif"
    insert_before_line "$file" "$first_stmt_line" "$hook_call"

    verify_patch_applied "$file" "ksu_handle_faccessat" || { log_error "Patch verification failed for open.c"; return 1; }

    return 0
}

# --- Patch: fs/read_write.c ---
# KernelSU original: hooks vfs_read (NOT the syscall) with ksu_handle_vfs_read
#
# Robustness: parse the ACTUAL parameter names of vfs_read (they vary across
# kernels: file/buf/count/pos is common but not universal) and use them in the
# hook call. Only emit the hook if the four expected parameters exist.
patch_read_write_c() {
    local file="$1"

    if verify_patch_applied "$file" "ksu_handle_vfs_read"; then
        log_debug "read_write.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find vfs_read function (NOT ksys_read, NOT SYSCALL_DEFINE)
    local vfs_read_line
    vfs_read_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*ssize_t[[:space:]]+vfs_read[[:space:]]*[(]' \
        '^[[:space:]]*ssize_t[[:space:]]+__vfs_read[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+ssize_t[[:space:]]+vfs_read[[:space:]]*[(]'
    )
    [[ -n "$vfs_read_line" ]] || { log_error "Could not find vfs_read in $file"; return 1; }

    # Parse the real parameter names. Expected: vfs_read(struct file *file,
    # char __user *buf, size_t count, loff_t *pos)
    local params
    params=$(parse_function_params "$file" "$vfs_read_line")
    local p_file p_buf p_count p_pos
    p_file=$(printf '%s\n' "$params" | sed -n '1p')
    p_buf=$(printf '%s\n' "$params" | sed -n '2p')
    p_count=$(printf '%s\n' "$params" | sed -n '3p')
    p_pos=$(printf '%s\n' "$params" | sed -n '4p')
    if [[ -z "$p_file" || -z "$p_buf" || -z "$p_count" || -z "$p_pos" ]]; then
        log_error "vfs_read in $file does not have the expected 4 parameters (got: $(echo "$params" | tr '\n' ' '))"
        return 1
    fi

    # Add extern declarations before vfs_read
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern bool ksu_vfs_read_hook __read_mostly;
${indent}extern int ksu_handle_vfs_read(struct file **file_ptr, char __user **buf_ptr,
${indent}                       size_t *count_ptr, loff_t **pos);
${indent}#endif"
    insert_before_line "$file" "$vfs_read_line" "$extern_decl"

    # Insert the hook call at the first executable statement of vfs_read's
    # body (after all local declarations), so all four parameters are in
    # scope AND the placement does not violate
    # -Werror,-Wdeclaration-after-statement under clang. Naively placing the
    # hook right after the opening brace would fail to compile on kernels
    # built with clang when the function declares local variables immediately
    # after the brace.
    local brace_line
    brace_line=$(find_function_end "$file" "$vfs_read_line" '[{]')
    [[ -n "$brace_line" ]] || { log_error "Could not find opening brace of vfs_read"; return 1; }

    local first_stmt_line
    first_stmt_line=$(find_after_declarations "$file" "$brace_line")
    [[ -n "$first_stmt_line" ]] || first_stmt_line=$((brace_line + 1))

    local body_indent
    body_indent=$(detect_indent "$file" "$brace_line")

    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    if (unlikely(ksu_vfs_read_hook))
${body_indent}        ksu_handle_vfs_read(&$p_file, &$p_buf, &$p_count, &$p_pos);
${body_indent}#endif"
    insert_before_line "$file" "$first_stmt_line" "$hook_call"

    verify_patch_applied "$file" "ksu_handle_vfs_read" || { log_error "Patch verification failed for read_write.c"; return 1; }

    return 0
}

# --- Patch: fs/stat.c ---
# KernelSU original: hooks vfs_statx (or vfs_fstatat fallback for older kernels)
#
# Robustness: parse the ACTUAL parameter names of the located function. vfs_statx
# and vfs_fstatat name their flags parameter differently (flags vs flag), and the
# dfd/filename positions can vary, so we detect the flags parameter by name rather
# than assuming a fixed position. The hook is only emitted if dfd, filename, and a
# flags parameter all exist.
patch_stat_c() {
    local file="$1"

    if verify_patch_applied "$file" "ksu_handle_stat"; then
        log_debug "stat.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Try vfs_statx first (newer kernels), then fall back to vfs_fstatat (older)
    local statx_line
    statx_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*int[[:space:]]+vfs_statx[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+vfs_statx[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+vfs_fstatat[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+vfs_fstatat[[:space:]]*[(]'
    )
    [[ -n "$statx_line" ]] || { log_error "Could not find vfs_statx or vfs_fstatat in $file"; return 1; }

    # Parse the real parameter names.
    #   vfs_statx(int dfd, const char __user *filename, int flags, ...)
    #   vfs_fstatat(int dfd, const char __user *filename, struct kstat *stat, int flag)
    # We need dfd (1st), filename (2nd), and the flags param (name contains "flag").
    local params
    params=$(parse_function_params "$file" "$statx_line")
    local p_dfd p_filename p_flags
    p_dfd=$(printf '%s\n' "$params" | sed -n '1p')
    p_filename=$(printf '%s\n' "$params" | sed -n '2p')
    p_flags=$(printf '%s\n' "$params" | grep -i 'flag' | head -1)
    if [[ -z "$p_dfd" || -z "$p_filename" || -z "$p_flags" ]]; then
        log_error "vfs_statx/vfs_fstatat in $file does not have dfd/filename/flags params (got: $(echo "$params" | tr '\n' ' '))"
        return 1
    fi

    # Add extern declaration before the function
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern int ksu_handle_stat(int *dfd, const char __user **filename_user, int *flags);
${indent}#endif"
    insert_before_line "$file" "$statx_line" "$extern_decl"

    # Insert the hook call at the first executable statement of the function
    # body (after all local declarations), so all parameters are in scope AND
    # the placement does not violate -Werror,-Wdeclaration-after-statement
    # under clang. Naively placing the hook right after the opening brace
    # would fail to compile on kernels built with clang when the function
    # declares local variables immediately after the brace.
    local brace_line
    brace_line=$(find_function_end "$file" "$statx_line" '[{]')
    [[ -n "$brace_line" ]] || { log_error "Could not find opening brace of vfs_statx/vfs_fstatat"; return 1; }

    local first_stmt_line
    first_stmt_line=$(find_after_declarations "$file" "$brace_line")
    [[ -n "$first_stmt_line" ]] || first_stmt_line=$((brace_line + 1))

    local body_indent
    body_indent=$(detect_indent "$file" "$brace_line")

    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    ksu_handle_stat(&$p_dfd, &$p_filename, &$p_flags);
${body_indent}#endif"
    insert_before_line "$file" "$first_stmt_line" "$hook_call"

    verify_patch_applied "$file" "ksu_handle_stat" || { log_error "Patch verification failed for stat.c"; return 1; }

    return 0
}

# ============================================================================
# Backport Functions
# ============================================================================

# --- Backport 1: fs/namespace.c (path_umount from kernel 5.9) ---
# Required for "Umount module" feature on kernels older than 5.9
#
# This is intentionally written to be robust across ALL kernel versions, not a
# specific one. The strategy:
#   1. Skip if already patched (our guarded block is present).
#   2. Skip if the kernel already provides a native path_umount() (>= 5.9):
#      injecting another one would cause a duplicate-symbol build error.
#   3. Pick an insertion point from a priority list of anchors, every one of
#      which is resolved to a line that is OUTSIDE any /* */ comment:
#        a. after the '#endif' closing the 'may_mandlock' guard (5.x)
#        b. after the 'Now umount can handle mount points' comment block closes
#        c. immediately BEFORE SYSCALL_DEFINE2(umount, ...)  (universal anchor)
#        d. after the closing brace of do_umount()
#   4. Last resort: append at end of file (with a warning).
#   5. Self-check: the whole file must have balanced /* */ comments afterwards
#      and the injected #ifdef CONFIG_KSU must be outside any comment.
patch_namespace_c() {
    local file="$1"

    [[ -f "$file" ]] || { log_error "File not found: $file"; return 1; }

    # Build a "comment map": for every line, emit "NR STATE RESTOFLINE" where
    # STATE is 1 if the line STARTS inside a /* ... */ comment and 0 otherwise.
    # This lets every anchor lookup be comment-aware (the bug we fixed: an anchor
    # that lived inside a comment used to split that comment open).
    local comment_map
    comment_map=$(awk '
        BEGIN { in_c = 0 }
        {
            line = $0
            out = in_c
            i = 1
            n = length(line)
            while (i <= n - 1) {
                two = substr(line, i, 2)
                if (in_c) {
                    if (two == "*/") { in_c = 0; i += 2; continue }
                } else {
                    if (two == "/*") { in_c = 1; i += 2; continue }
                }
                i++
            }
            print NR " " out " " $0
        }
    ' "$file")

    # --- helpers (operate on comment_map) ---
    # First line (any comment state) matching ERE.
    local _ln
    ns_first()  { awk -v pat="$1" '$0 ~ pat { print $1; exit }' <<<"$comment_map"; }
    # Is line L inside a comment? echoes 1/0.
    ns_inside() { awk -v ln="$1" '$1 == ln { print $2; exit }' <<<"$comment_map"; }
    # Line number of the '*/' that closes the comment containing line L.
    ns_close()  {
        awk -v start="$1" '
            NR >= start {
                if ($2 == 1 && /\*\//) { print NR; exit }
            }
        ' <<<"$comment_map"
    }

    # 1. Already patched? Our guarded block present => nothing to do.
    if grep -q '#ifdef CONFIG_KSU' "$file" && grep -q "path_umount" "$file"; then
        # Confirm the #ifdef is outside a comment (a real application).
        local ksu_l
        ksu_l=$(ns_first '#ifdef CONFIG_KSU')
        if [[ -n "$ksu_l" && "$(ns_inside "$ksu_l")" == "0" ]]; then
            log_info "namespace.c already has the KernelSU path_umount backport; skipping"
            return 0
        fi
    fi

    # 2. Native path_umount present (kernel >= 5.9)? Backport not needed.
    if grep -q "path_umount" "$file" && ! grep -q '#ifdef CONFIG_KSU' "$file"; then
        log_info "native path_umount() detected in namespace.c (kernel >= 5.9?); backport not required, skipping"
        return 0
    fi

    # 3. Choose insertion point (priority order). Each must resolve to a line
    #    that is OUTSIDE any comment.
    local insert_line=""

    # 3a. After the '#endif' closing the may_mandlock guard.
    local mandlock
    mandlock=$(ns_first 'may_mandlock')
    if [[ -n "$mandlock" && "$(ns_inside "$mandlock")" == "0" ]]; then
        local endif_l
        endif_l=$(awk -v start="$mandlock" '
            NR > start && $2 == 0 && /^[[:space:]]*#endif/ { print $1; exit }
        ' <<<"$comment_map")
        if [[ -n "$endif_l" ]]; then
            insert_line=$((endif_l + 1))
        fi
    fi

    # 3b. After the "Now umount can handle mount points" comment block closes.
    if [[ -z "$insert_line" ]]; then
        local now_l
        now_l=$(ns_first 'Now umount can handle mount points')
        if [[ -n "$now_l" ]]; then
            local close_l
            close_l=$(ns_close "$now_l")
            if [[ -n "$close_l" ]]; then
                insert_line=$((close_l + 1))
            fi
        fi
    fi

    # 3c. Immediately BEFORE SYSCALL_DEFINE2(umount, ...) — universal anchor.
    if [[ -z "$insert_line" ]]; then
        local umount_l
        umount_l=$(awk '$2 == 0 && $0 ~ /SYSCALL_DEFINE2\(umount/ { print $1; exit }' <<<"$comment_map")
        if [[ -n "$umount_l" ]]; then
            insert_line="$umount_l"   # insert BEFORE this line
        fi
    fi

    # 3d. After the closing brace of do_umount().
    if [[ -z "$insert_line" ]]; then
        local do_l
        do_l=$(awk '$2 == 0 && $0 ~ /^[a-zA-Z].*do_umount\(/ { print $1; exit }' <<<"$comment_map")
        if [[ -n "$do_l" ]]; then
            # Find the next top-level "}" after do_umount's opening brace.
            local brace_l
            brace_l=$(awk -v start="$do_l" '
                NR > start && $2 == 0 && $0 ~ /^[[:space:]]*\}[[:space:]]*$/ { print $1; exit }
            ' <<<"$comment_map")
            if [[ -n "$brace_l" ]]; then
                insert_line=$((brace_l + 1))
            fi
        fi
    fi

    # 3e. Last resort: append at end of file.
    if [[ -z "$insert_line" ]]; then
        log_warn "Could not find a safe anchor in namespace.c; appending path_umount at end of file"
        insert_line=$(wc -l < "$file")
        insert_line=$((insert_line + 1))
    fi

    # Guard: never insert inside a comment. If somehow we did, bail.
    if [[ "$(ns_inside "$insert_line")" == "1" ]]; then
        log_error "Internal error: chosen insertion line $insert_line is inside a comment; aborting"
        return 1
    fi

    # Use column-0 indentation to match KernelSU's published backport patch
    # (preprocessor directives are conventionally at column 0; the inner body
    # keeps KernelSU's documented 8-space indentation).
    local indent=""

    # The path_umount backport block (verbatim from KernelSU original docs)
    local backport_block="${indent}#ifdef CONFIG_KSU
${indent}static int can_umount(const struct path *path, int flags)
${indent}{
${indent}       struct mount *mnt = real_mount(path->mnt);
${indent}
${indent}       if (flags & ~(MNT_FORCE | MNT_DETACH | MNT_EXPIRE | UMOUNT_NOFOLLOW))
${indent}               return -EINVAL;
${indent}       if (!may_mount())
${indent}               return -EPERM;
${indent}       if (path->dentry != path->mnt->mnt_root)
${indent}               return -EINVAL;
${indent}       if (!check_mnt(mnt))
${indent}               return -EINVAL;
${indent}       if (mnt->mnt.mnt_flags & MNT_LOCKED) /* Check optimistically */
${indent}               return -EINVAL;
${indent}       if (flags & MNT_FORCE && !capable(CAP_SYS_ADMIN))
${indent}               return -EPERM;
${indent}       return 0;
${indent}}
${indent}
${indent}int path_umount(struct path *path, int flags)
${indent}{
${indent}       struct mount *mnt = real_mount(path->mnt);
${indent}       int ret;
${indent}
${indent}       ret = can_umount(path, flags);
${indent}       if (!ret)
${indent}               ret = do_umount(mnt, flags);
${indent}
${indent}       /* we mustn't call path_put() as that would clear mnt_expiry_mark */
${indent}       dput(path->dentry);
${indent}       mntput_no_expire(mnt);
${indent}       return ret;
${indent}}
${indent}#endif"

    insert_before_line "$file" "$insert_line" "$backport_block"

    # 5. Self-check: the whole file must still have BALANCED /* */ comments.
    # This is the strongest guard against the "split comment" class of bug.
    local balance
    balance=$(awk '
        BEGIN { in_c = 0 }
        {
            line = $0; i = 1; n = length(line)
            while (i <= n - 1) {
                two = substr(line, i, 2)
                if (in_c) { if (two == "*/") { in_c = 0; i += 2; continue } }
                else { if (two == "/*") { in_c = 1; i += 2; continue } }
                i++
            }
        }
        END { print in_c }
    ' "$file")
    if [[ "$balance" != "0" ]]; then
        log_error "Patch verification failed for namespace.c: comment balance is $balance (expected 0)"
        return 1
    fi

    # And the injected #ifdef must be outside any comment.
    local ksu_ifdef_line
    ksu_ifdef_line=$(awk -v start="$insert_line" '
        BEGIN { in_c = 0 }
        NR >= start {
            line = $0; i = 1; n = length(line)
            while (i <= n - 1) {
                two = substr(line, i, 2)
                if (in_c) { if (two == "*/") { in_c = 0; i += 2; continue } }
                else { if (two == "/*") { in_c = 1; i += 2; continue } }
                i++
            }
            if (!in_c && $0 ~ /#ifdef CONFIG_KSU/) { print NR; exit }
        }
    ' "$file")
    if [[ -z "$ksu_ifdef_line" ]]; then
        log_error "Patch verification failed for namespace.c: injected CONFIG_KSU block is inside a comment"
        return 1
    fi

    # And the canonical hook symbol must be reachable (outside comments).
    verify_patch_applied "$file" "$BACKPORT_PATH_UMOUNT_HOOK" \
        || { log_error "Patch verification failed for namespace.c (path_umount)"; return 1; }

    return 0
}

apply_backport_path_umount() {
    log_step "Applying path_umount backport (KernelSU original, for pre-5.9 kernels)"

    local filepath="$KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE"

    if [[ ! -f "$filepath" ]]; then
        log_error "File not found: $filepath"
        return 1
    fi

    log_info "Patching $BACKPORT_PATH_UMOUNT_FILE..."

    if patch_namespace_c "$filepath"; then
        log_success "Patched $BACKPORT_PATH_UMOUNT_FILE (path_umount backport applied)"
    else
        log_error "Failed to patch $BACKPORT_PATH_UMOUNT_FILE"
        return 1
    fi

    return 0
}

# --- Backport 2: fs/devpts/inode.c (fix "pm execution failed") ---
# Patches devpts_get_priv to call ksu_handle_devpts
patch_devpts_c() {
    local file="$1"

    if verify_patch_applied "$file" "$BACKPORT_DEVPTS_HOOK"; then
        log_debug "devpts/inode.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find devpts_get_priv function
    local devpts_line
    devpts_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*void[[:space:]]*[*][[:space:]]*devpts_get_priv[[:space:]]*[(]' \
        '^[[:space:]]*void[[:space:]]+devpts_get_priv[[:space:]]*[(]' \
        '^[[:space:]]*devpts_get_priv[[:space:]]*[(]'
    )
    [[ -n "$devpts_line" ]] || { log_error "Could not find devpts_get_priv in $file"; return 1; }

    # Add extern declaration before the function
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern int ksu_handle_devpts(struct inode*);
${indent}#endif"
    insert_before_line "$file" "$devpts_line" "$extern_decl"

    # Find the function body - search for first executable statement directly
    # from the function signature line. This handles both brace styles:
    #   Style 1 (kernel standard): brace on its own line
    #     void *devpts_get_priv(struct dentry *dentry)
    #     {
    #   Style 2 (compact): brace on same line as signature
    #     void *devpts_get_priv(struct dentry *dentry) {
    # The official patch inserts ksu_handle_devpts(dentry->d_inode) at the start
    # of devpts_get_priv, before the dentry->d_sb->s_magic check.
    local body_patterns=(
        'dentry->d_sb'
        'dentry->d_inode'
        'return[[:space:]]'
        'if[[:space:]]*[(]'
    )
    local body_line
    for pattern in "${body_patterns[@]}"; do
        body_line=$(find_function_end "$file" "$devpts_line" "$pattern")
        [[ -n "$body_line" ]] && break
    done

    [[ -n "$body_line" ]] || { log_error "Could not find insertion point in devpts_get_priv"; return 1; }

    local body_indent
    body_indent=$(detect_indent "$file" "$body_line")

    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    ksu_handle_devpts(dentry->d_inode);
${body_indent}#endif"
    insert_before_line "$file" "$body_line" "$hook_call"

    verify_patch_applied "$file" "$BACKPORT_DEVPTS_HOOK" \
        || { log_error "Patch verification failed for devpts/inode.c"; return 1; }

    return 0
}

apply_backport_devpts() {
    log_step "Applying devpts backport (fix 'pm execution failed' in terminal)"

    local filepath="$KERNEL_SRC/$BACKPORT_DEVPTS_FILE"

    if [[ ! -f "$filepath" ]]; then
        log_error "File not found: $filepath"
        return 1
    fi

    log_info "Patching $BACKPORT_DEVPTS_FILE..."

    if patch_devpts_c "$filepath"; then
        log_success "Patched $BACKPORT_DEVPTS_FILE (devpts backport applied)"
    else
        log_error "Failed to patch $BACKPORT_DEVPTS_FILE"
        return 1
    fi

    return 0
}

# --- Backport 3: drivers/input/input.c (Safe Mode) ---
# Patches input_handle_event to call ksu_handle_input_handle_event
patch_input_c() {
    local file="$1"

    if verify_patch_applied "$file" "$BACKPORT_SAFE_MODE_HOOK"; then
        log_debug "input.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find input_handle_event function
    local input_line
    input_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*static[[:space:]]+void[[:space:]]+input_handle_event[[:space:]]*[(]' \
        '^[[:space:]]*void[[:space:]]+input_handle_event[[:space:]]*[(]' \
        '^[[:space:]]*input_handle_event[[:space:]]*[(]'
    )
    [[ -n "$input_line" ]] || { log_error "Could not find input_handle_event in $file"; return 1; }

    # Add extern declarations before the function
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern bool ksu_input_hook __read_mostly;
${indent}extern int ksu_handle_input_handle_event(unsigned int *type, unsigned int *code, int *value);
${indent}#endif"
    insert_before_line "$file" "$input_line" "$extern_decl"

    # Find input_get_disposition call inside the function
    # The official patch inserts the hook AFTER the input_get_disposition call
    local disposition_line
    disposition_line=$(find_function_end "$file" "$input_line" 'input_get_disposition')
    [[ -n "$disposition_line" ]] || { log_error "Could not find input_get_disposition call in input_handle_event"; return 1; }

    local body_indent
    body_indent=$(detect_indent "$file" "$disposition_line")

    # Insert AFTER the input_get_disposition line
    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    if (unlikely(ksu_input_hook))
${body_indent}        ksu_handle_input_handle_event(&type, &code, &value);
${body_indent}#endif"
    insert_after_line "$file" "$disposition_line" "$hook_call"

    verify_patch_applied "$file" "$BACKPORT_SAFE_MODE_HOOK" \
        || { log_error "Patch verification failed for input.c"; return 1; }

    return 0
}

apply_backport_safe_mode() {
    log_step "Applying Safe Mode backport (drivers/input/input.c)"

    local filepath="$KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE"

    if [[ ! -f "$filepath" ]]; then
        log_error "File not found: $filepath"
        return 1
    fi

    log_info "Patching $BACKPORT_SAFE_MODE_FILE..."

    if patch_input_c "$filepath"; then
        log_success "Patched $BACKPORT_SAFE_MODE_FILE (Safe Mode backport applied)"
        log_warn "If using manual integration, ensure CONFIG_KPROBES is disabled in defconfig"
        log_warn "  to prevent accidental Safe Mode triggers (volume down button after boot)"
    else
        log_error "Failed to patch $BACKPORT_SAFE_MODE_FILE"
        return 1
    fi

    return 0
}

# ============================================================================
# Kprobe Method - Config Only
# ============================================================================
apply_kprobe_configs() {
    log_step "Applying kprobe method configurations"

    update_defconfig "${KPROBE_CONFIGS[@]}"

    log_success "Kprobe configurations applied to defconfig"
    log_info "Note: Verify kprobe works on your kernel. If bootloop occurs, kprobe may be broken."
    log_info "Test: Comment out ksu_sucompat_init() and ksu_ksud_init() in KernelSU/kernel/ksu.c"
    log_info "If kernel < 5.9, also use --backport-path_umount for 'Umount module' feature"
}

# ============================================================================
# Verification
# ============================================================================
verify_integration() {
    log_step "Verifying integration"

    # Standalone backport mode: only verify the specific backport patches
    if [[ "$METHOD" == "standalone" ]]; then
        local backport_errors=()

        if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
            local ns_file="$KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE"
            if [[ -f "$ns_file" ]]; then
                grep -q "$BACKPORT_PATH_UMOUNT_HOOK" "$ns_file" \
                    || backport_errors+=("path_umount not found in $BACKPORT_PATH_UMOUNT_FILE")
            else
                backport_errors+=("$BACKPORT_PATH_UMOUNT_FILE not found")
            fi
        fi

        if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
            local devpts_file="$KERNEL_SRC/$BACKPORT_DEVPTS_FILE"
            if [[ -f "$devpts_file" ]]; then
                grep -q "$BACKPORT_DEVPTS_HOOK" "$devpts_file" \
                    || backport_errors+=("devpts hook not found in $BACKPORT_DEVPTS_FILE")
            else
                backport_errors+=("$BACKPORT_DEVPTS_FILE not found")
            fi
        fi

        if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
            local input_file="$KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE"
            if [[ -f "$input_file" ]]; then
                grep -q "$BACKPORT_SAFE_MODE_HOOK" "$input_file" \
                    || backport_errors+=("safe_mode hook not found in $BACKPORT_SAFE_MODE_FILE")
            else
                backport_errors+=("$BACKPORT_SAFE_MODE_FILE not found")
            fi
        fi

        if [[ ${#backport_errors[@]} -gt 0 ]]; then
            die "Backport verification failed: ${backport_errors[*]}"
        fi

        log_success "Backport patches verified successfully"
        return
    fi

    # Normal mode: full integration verification
    # Check KernelSU source exists (external submodule structure)
    [[ -d "$KSU_KERNEL_SOURCE" ]] || die "KernelSU kernel source missing at $KSU_KERNEL_SOURCE"
    [[ -f "$KSU_KERNEL_SOURCE/Kconfig" ]] || die "KernelSU source incomplete - Kconfig missing"
    # KernelSU original (v0.9.5) uses core_hook.c, not core/init.c
    [[ -f "$KSU_KERNEL_SOURCE/core_hook.c" ]] || die "KernelSU source incomplete - core_hook.c missing"
    [[ -f "$KSU_KERNEL_SOURCE/ksu.c" ]] || die "KernelSU source incomplete - ksu.c missing"

    # Check symlink exists in kernel source
    local driver_dir
    if [[ -d "$KERNEL_SRC/common/drivers" ]]; then
        driver_dir="common/drivers"
    elif [[ -d "$KERNEL_SRC/drivers" ]]; then
        driver_dir="drivers"
    else
        die "Could not find drivers/ directory in kernel source"
    fi
    [[ -L "$KERNEL_SRC/$driver_dir/kernelsu" || -d "$KERNEL_SRC/$driver_dir/kernelsu" ]] \
        || die "kernelsu integration missing in $driver_dir (expected symlink or --integrate copy)"

    # Check defconfig has CONFIG_KSU
    grep -q "^CONFIG_KSU=y" "$DEFCONFIG_PATH" || die "CONFIG_KSU not enabled in defconfig"

    if [[ "$METHOD" == "kprobe" ]]; then
        for config in "${KPROBE_CONFIGS[@]}"; do
            local key="${config%%=*}"
            grep -q "^${key}=y" "$DEFCONFIG_PATH" || log_warn "Config not set: $key"
        done
    else
        # Verify patches applied by checking for hook calls (4 files)
        if [[ $SKIP_PATCHES -eq 1 ]]; then
            log_warn "Skipping manual patch verification (--skip-patchs)"
        else
            local missing_hooks=()
            grep -q "ksu_handle_execveat" "$KERNEL_SRC/fs/exec.c" || missing_hooks+=("exec.c")
            grep -q "ksu_handle_faccessat" "$KERNEL_SRC/fs/open.c" || missing_hooks+=("open.c")
            grep -q "ksu_handle_vfs_read" "$KERNEL_SRC/fs/read_write.c" || missing_hooks+=("read_write.c")
            grep -q "ksu_handle_stat" "$KERNEL_SRC/fs/stat.c" || missing_hooks+=("stat.c")

            if [[ ${#missing_hooks[@]} -gt 0 ]]; then
                die "Manual patches incomplete. Missing hooks in: ${missing_hooks[*]}"
            fi
        fi
    fi

    # Verify backports if enabled in full integration mode
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        if [[ $SKIP_PATCHES -eq 1 ]]; then
            log_warn "Skipping backport verification (--skip-patchs)"
        else
            local backport_errors=()

            if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
                local ns_file="$KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE"
                if [[ -f "$ns_file" ]]; then
                    grep -q "$BACKPORT_PATH_UMOUNT_HOOK" "$ns_file" \
                        || backport_errors+=("path_umount not found in $BACKPORT_PATH_UMOUNT_FILE")
                else
                    backport_errors+=("$BACKPORT_PATH_UMOUNT_FILE not found")
                fi
            fi

            if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
                local devpts_file="$KERNEL_SRC/$BACKPORT_DEVPTS_FILE"
                if [[ -f "$devpts_file" ]]; then
                    grep -q "$BACKPORT_DEVPTS_HOOK" "$devpts_file" \
                        || backport_errors+=("devpts hook not found in $BACKPORT_DEVPTS_FILE")
                else
                    backport_errors+=("$BACKPORT_DEVPTS_FILE not found")
                fi
            fi

            if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
                local input_file="$KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE"
                if [[ -f "$input_file" ]]; then
                    grep -q "$BACKPORT_SAFE_MODE_HOOK" "$input_file" \
                        || backport_errors+=("safe_mode hook not found in $BACKPORT_SAFE_MODE_FILE")
                else
                    backport_errors+=("$BACKPORT_SAFE_MODE_FILE not found")
                fi
            fi

            if [[ ${#backport_errors[@]} -gt 0 ]]; then
                die "Backport verification failed: ${backport_errors[*]}"
            fi

            log_success "Backport patches verified successfully"
        fi
    fi

    log_success "Integration verified successfully"
}

# ============================================================================
# Main
# ============================================================================
main() {
    validate_args "$@"
    check_prerequisites

    log_info "KernelSU (original) Integration Script v$SCRIPT_VERSION"
    log_info "Method: $METHOD | Kernel: $KERNEL_SRC | Defconfig: ${DEFCONFIG_PATH:-<none>}"

    # =========================================================================
    # Standalone backport mode
    # Only apply the specified backport(s). Skip all other steps.
    # =========================================================================
    if [[ "$METHOD" == "standalone" ]]; then
        log_step "Standalone backport mode: $(get_backport_list)"

        if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
            apply_backport_path_umount || die "path_umount backport failed"
        fi
        if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
            apply_backport_devpts || die "devpts backport failed"
        fi
        if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
            apply_backport_safe_mode || die "safe_mode backport failed"
        fi

        verify_integration

        log_step "Integration Complete"
        log_success "Backport patches applied: $(get_backport_list)"
        if [[ $CREATE_BACKUP -eq 1 ]]; then
            log_info "Backup files created: *.ksu-backup.* in patched directories"
        fi
        log_info "Next steps:"
        log_info "  1. Build your kernel: make -C $KERNEL_SRC"
        log_info "  2. Flash the resulting boot.img"
        return
    fi

    # =========================================================================
    # Normal flow: full KSU integration
    # =========================================================================

    # Pre-flight detection of existing KSU integration
    detect_existing_ksu

    fetch_ksu_source

    case "$METHOD" in
        kprobe)
            apply_kprobe_configs
            ;;
        manual)
            # Per docs: manual method only needs CONFIG_KSU=y
            # Also disable kprobe configs to prevent conflicts
            log_step "Configuring defconfig for manual method"
            update_defconfig "CONFIG_KPROBES=n" "CONFIG_HAVE_KPROBES=n" "CONFIG_KPROBE_EVENTS=n"
            update_defconfig "${MANUAL_CONFIGS[@]}"
            if [[ $SKIP_PATCHES -eq 1 ]]; then
                log_warn "--skip-patchs specified: skipping manual integration patches (4 fs/*.c files)"
            else
                apply_manual_patches
            fi
            ;;
    esac

    # Apply backports if requested in full integration mode
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        if [[ $SKIP_PATCHES -eq 1 ]]; then
            log_warn "--skip-patchs specified: skipping backport patches ($(get_backport_list))"
        else
            log_step "Applying backport patches"
            if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
                apply_backport_path_umount || die "path_umount backport failed"
            fi
            if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
                apply_backport_devpts || die "devpts backport failed"
            fi
            if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
                apply_backport_safe_mode || die "safe_mode backport failed"
            fi
        fi
    fi

    verify_integration

    log_step "Integration Complete"
    log_success "KernelSU (original, tag: $KSU_TAG) integrated using '$METHOD' method"
    if [[ $SKIP_PATCHES -eq 1 ]]; then
        log_warn "Patches were SKIPPED (--skip-patchs). Source tree is ready, but hooks are NOT applied yet."
        log_info "Re-run without --skip-patchs to apply the patches:"
        log_info "  $SCRIPT_NAME $METHOD $KERNEL_SRC $(basename "$DEFCONFIG_PATH" 2>/dev/null || echo '<defconfig>')"
    fi
    log_info "Next steps:"
    log_info "  1. Build your kernel: make -C $KERNEL_SRC $(basename "$DEFCONFIG_PATH") && make -C $KERNEL_SRC"
    log_info "  2. Flash the resulting boot.img"
    log_info "  3. If using kprobe and bootloops: kprobe is broken, use 'manual' method instead"

    if [[ "$METHOD" == "manual" ]]; then
        if [[ $CREATE_BACKUP -eq 1 ]]; then
            log_info "  Backup files created: *.ksu-backup.* in each patched directory"
        fi
    fi

    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        log_info "  Backports applied: $(get_backport_list)"
    else
        log_info "  Optional backports (run separately if needed):"
        log_info "    --backport-path_umount  (for 'Umount module' on pre-5.9 kernels)"
        log_info "    --backport-devpts       (fixes 'pm' execution in terminal)"
        log_info "    --backport-safe-mode    (enables Safe Mode)"
        log_info "    --backport-all          (all three above)"
    fi
}

# Handle script arguments
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
        show_usage
        exit 0
    fi
    main "$@"
fi
