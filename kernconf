#!/usr/bin/env python3
"""
kernconf - Kernel config comparison and synchronization tool

Usage:
    kernconf check <source_config> <device_config> [--filter critical|important]
    kernconf sync <source_config> <device_config> [-o|--output <output_path>] [--filter critical|important]

Examples:
    kernconf check ./san-kernel-4.19/arch/arm64/configs/vendor/lavender-perf_defconfig lavender.devconfig
    kernconf check ./san-kernel-4.19/arch/arm64/configs/vendor/lavender-perf_defconfig lavender.devconfig --filter critical
    kernconf sync ./san-kernel-4.19/arch/arm64/configs/vendor/lavender-perf_defconfig lavender.devconfig -o lavender_synced_defconfig --filter important
"""

