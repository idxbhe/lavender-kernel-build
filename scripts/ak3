#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

TEMPLATE="norm"
PATH_ARG=""

usage() {
    cat <<EOF
Usage: $(basename "$0") [path] [--template <template>]

Arguments:
  [path]               Path to kernel output (relative to $BASE_DIR/kernels
                       if not absolute; absolute path also accepted)

Options:
  --template <value>   Template name under templates/AnyKernel3/
                       (default: norm)
EOF
    exit 1
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --template)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --template requires a value" >&2
                usage
            fi
            TEMPLATE="$2"
            shift 2
            ;;
        --help|-h)
            usage
            ;;
        -*)
            echo "Error: Unknown option $1" >&2
            usage
            ;;
        *)
            if [[ -n "$PATH_ARG" ]]; then
                echo "Error: Multiple path arguments provided" >&2
                usage
            fi
            PATH_ARG="$1"
            shift
            ;;
    esac
done

if [[ -z "$PATH_ARG" ]]; then
    echo "Error: [path] is required" >&2
    usage
fi

# Resolve path argument
if [[ "$PATH_ARG" = /* ]]; then
    KERNEL_PATH="$PATH_ARG"
else
    KERNEL_PATH="$BASE_DIR/kernels/$PATH_ARG"
fi

# Validate template directory
TEMPLATE_DIR="$BASE_DIR/templates/AnyKernel3/$TEMPLATE"
if [[ ! -d "$TEMPLATE_DIR" ]]; then
    echo "Error: Template directory not found: $TEMPLATE_DIR" >&2
    echo "Available templates: $(ls -1 "$BASE_DIR/templates/AnyKernel3" 2>/dev/null || echo 'none')" >&2
    exit 1
fi

# Validate image source
IMAGE_SRC="$KERNEL_PATH/out/arch/arm64/boot/Image.gz-dtb"
if [[ ! -f "$IMAGE_SRC" ]]; then
    echo "Error: Image.gz-dtb not found at: $IMAGE_SRC" >&2
    exit 1
fi

# Create temporary directory
TEMP_DIR=$(mktemp -d)
trap 'echo "Temporary directory kept at: $TEMP_DIR"; exit' EXIT

echo "Using template: $TEMPLATE"
echo "Source image: $IMAGE_SRC"
echo "Temp directory: $TEMP_DIR"

# Copy template contents
cp -r "$TEMPLATE_DIR"/* "$TEMP_DIR/"

# Copy kernel image
cp "$IMAGE_SRC" "$TEMP_DIR/"

# Prompt for zip name
read -r -p "Enter zipname (without .zip): " ZIPNAME
if [[ -z "$ZIPNAME" ]]; then
    echo "Error: zipname cannot be empty" >&2
    exit 1
fi

# Ensure release directory exists
mkdir -p "$BASE_DIR/release"

# Create zip from tempdir
# Running from within TEMP_DIR so paths are clean
(cd "$TEMP_DIR" && zip -r9 "$BASE_DIR/release/${ZIPNAME}.zip" -x ".git" "README.md" "placeholder" .)

echo "Created: $BASE_DIR/release/${ZIPNAME}.zip"
