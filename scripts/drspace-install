# ==============================================
#  UTILS
# ==============================================

_VERBOSE = False  # set by --verbose flag in main()


def log(s: str, level: str = "info"):
    if level == "verbose" and not _VERBOSE:
        return
    tag = {"info":"[INFO]", "warn":"[WARN]", "error":"[ERROR]", "ok":"[OK]", "verbose":"[VRBS]"}.get(level, "[INFO]")
    print(f"{tag} {s}")


def get_kernel_version(src_path: Path) -> tuple[int, int, int]:
    makefile = src_path / "Makefile"
    if not makefile.exists():
        # Some trees keep version in makefile fragments; search broadly
        candidates = list(src_path.rglob("Makefile"))
        if not candidates:
            raise SystemExit(f"No Makefile found in kernel source: {src_path}")
        makefile = candidates[0]
    text = makefile.read_text()
    m = re.search(r"VERSION\s*=" + r"\s*(\d+)", text)
    p = re.search(r"PATCHLEVEL\s*=" + r"\s*(\d+)", text)
    s = re.search(r"SUBLEVEL\s*=" + r"\s*(\d+)", text)
    if not m or not p:
        raise SystemExit(f"Could not extract kernel version from {makefile}")
    ver = int(m.group(1))
    patch = int(p.group(1))
    sub = int(s.group(1)) if s else 0
    return (ver, patch, sub)


def is_gki(src_path: Path) -> bool:
    # GKI has a dedicated defconfig; but also check version
    version = get_kernel_version(src_path)
    has_gki_defconfig = (src_path / "arch" / "arm64" / "configs" / "gki_defconfig").exists()
    # If kernel version >= 5.4 and gki_defconfig exists => GKI path is safer
    # Even if defconfig name doesn't say "gki", the presence of the patch targets and version tells the story.
    # Per docs: GKI applies to 5.4+, 5.10, 5.15, 6.1, 6.6, 6.12+
    return version[0] >= 5 and version[1] >= 4 or version[0] > 5


def detect_gki_variant(src_path: Path) -> tuple[str, bool]:
    """Returns (variant, needs_mqueue_patch).
    variant: 'below_612', 'above_612'
    needs_mqueue_patch: whether <= 5.10 needs the POSIX_MQUEUE kABI fix.
    """
    version = get_kernel_version(src_path)
    needs_mq = (version[0] == 5 and version[1] <= 10) or version[0] < 5
    # But doc says 5.10 and below ONLY for non-GKI? Actually doc says for GKI:
    # "For Kernels 5.10 and BELOW ONLY: apply POSIX_MQUEUE kABI fix"
    # So for GKI, if kernel version <= 5.10, add mqueue.
    # For non-GKI, no special mqueue patch.
    needs_mq_gki = True if (version[0] == 5 and version[1] <= 10) or version[0] < 5 else False if version[0] > 5 or (version[0] == 5 and version[1] > 10) else False
    # Actually the doc says: "For Kernels 5.10 and BELOW ONLY" — that's for GKI kernels.
    # Non-GKI doesn't have this restriction. We'll only apply GKI-specific patches when in GKI mode.
    if version[0] > 6 or (version[0] == 6 and version[1] >= 12):
        return ("above_612", False)
    else:
        # 5.4, 5.10, 5.15, 6.1, 6.6 => below 6.12
        # Mqueue needed only for 5.10 and lower.
        mq = (version[0] < 5) or (version[0] == 5 and version[1] <= 10)
        return ("below_612", mq)


def read_defconfig(path: Path) -> list[str]:
    with open(path, "r") as f:
        return f.read().splitlines(keepends=True)


def write_defconfig(path: Path, lines: list[str]):
    with open(path, "w") as f:
        f.write("".join(lines))


def find_config_line(lines: list[str], name: str) -> int:
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("#"):
            # Check if it's a commented-out config
            # Format: # CONFIG_NAME is not set
            # or # CONFIG_NAME=y
            m = re.match(r"#\s*(CONFIG_[A-Z_]+)(?:\s+is\s+not\s+set)?", stripped)
            if m:
                if m.group(1) == name:
                    return i
        else:
            # Active config line
            parts = stripped.split("=")
            if len(parts) == 2 and parts[0].strip() == name:
                return i
    return -1


# ============================================================
#  KCONFIG SYMBOL DETECTION (dynamic, verbose, multilevel-fallback)
#
#  Workflow per simbol:
#    1. cek Kconfig untuk simbol primary
#    2. jika ada → pakai primary
#    3. jika tidak ada → cek fallback chain (ordered list, recursive)
#    4. jika ada yang match di chain → pakai yang pertama match
#    5. jika seluruh chain exhausted:
#       a. jika simbol ada di VERIFIED_UNSUPPORTED → SKIP dengan catatan
#       b. jika tidak → THROW SymbolResolutionError
#
#  Tujuannya: tidak ada auto-skip diam-diam untuk config WAJIB.
#  Saat menemukan entry baru yang belum terverifikasi, user HARUS
#  menyelidiki (lihat pesan error verbose) lalu mengisi:
#    - Fallback chain (jika ada alternatif di kernel modern/lama)
#    - atau VERIFIED_UNSUPPORTED (jika memang terbukti tidak ada
#      alternatif untuk simbol wajib tersebut di kernel tertentu)
# ============================================================


class SymbolResolutionError(Exception):
    """Raised when a mandatory config symbol cannot be resolved to any
    existing Kconfig symbol, AND it has not been declared in
    VERIFIED_UNSUPPORTED. This is by design: the script refuses to silently
    skip a mandatory symbol so the user investigates."""

    def __init__(self, symbol, attempted_chain):
        self.symbol = symbol
        self.attempted_chain = attempted_chain  # list of strings
        msg = (
            f"Cannot resolve mandatory config '{symbol}'. Attempted chain: "
            f"{attempted_chain}. If you have verified that none of these "
            f"symbols exist in this kernel AND no alternative exists, add "
            f"'{symbol}' to VERIFIED_UNSUPPORTED (with kernel context) to "
            f"explicitly acknowledge the skip."
        )
        super().__init__(msg)


# Multilevel fallback chain: each entry is a list (chain) of candidate
# symbols. The resolver tries each chain in order; within a chain, the
# first Kconfig-present symbol wins.
#
# Example: for NF_CONNTRACK_NETLINK, on newer kernels it's the primary.
# On 4.4 it was renamed NF_CT_NETLINK — so chain A = ["NF_CT_NETLINK"].
# If we discover a 3.18 variant later, add chain B = ["SOMETHING_3_18"].
FALLBACK_SYMBOLS: dict = {
    "CONFIG_NF_CONNTRACK_NETLINK": [
        ["CONFIG_NF_CT_NETLINK"],  # 4.4 renamed it
    ],
    "CONFIG_NETFILTER_XT_TARGET_MASQUERADE": [
        ["CONFIG_IP_NF_TARGET_MASQUERADE"],  # 4.4: iptables-only MASQUERADE
    ],
    "CONFIG_NETFILTER_XT_TARGET_REJECT": [
        ["CONFIG_IP_NF_TARGET_REJECT"],  # 4.x: iptables-only REJECT (xt alias removed)
    ],
    # CONFIG_FW_LOADER_COMPRESS added in 5.x; deliberately not in MANDATORY
    # list (see comment there). If you add it back, register a fallback here.
}


# Symbols whose absence we have VERIFIED (i.e., user has personally checked
# the Kconfig tree and confirmed there is no alternative). Add entries here
# only after manual investigation. The value is a free-form note explaining
# the rationale — it is printed at runtime for transparency.
#
# Format: { "CONFIG_FOO": "kernel-version-range: reason" }
# Example:
#   VERIFIED_UNSUPPORTED = {
#       "CONFIG_FW_LOADER_COMPRESS": "all pre-5.x: symbol did not exist; "
#       "no iptables-level fallback for firmware compression",
#   }
#
# Real entries (verified on stormbreaker 4.19-stable, 4.4 rave44, and current
# Droidspaces docs):
#   - NF_CONNTRACK_IPV4: in 4.19+ the symbol was merged into NF_CONNTRACK
#     itself (no separate ipv4 conntrack Kconfig exists). Functionality is
#     already enabled by CONFIG_NF_CONNTRACK=y. Verified via:
#       grep -n "^config NF_CONNTRACK_IPV4" \
#         net/netfilter/Kconfig net/ipv4/netfilter/Kconfig
#     → no matches on 4.19; on 4.4 the symbol also does not appear in Kconfig
#     (NF_CONNTRACK_IPV4 there was a silent alias handled by select chains).
VERIFIED_UNSUPPORTED: dict = {
    "CONFIG_NF_CONNTRACK_IPV4": (
        "4.19+ (and modern kernels): symbol merged into CONFIG_NF_CONNTRACK "
        "(verified: no `config NF_CONNTRACK_IPV4` in net/netfilter/Kconfig or "
        "net/ipv4/netfilter/Kconfig on 4.19.195). Functionality is covered "
        "by CONFIG_NF_CONNTRACK=y, which is already in MANDATORY_NON_GKI."
    ),
    "CONFIG_IP_NF_TARGET_ULOG": (
        "4.19+ (and modern kernels): ipt_ULOG was obsoleted by nf_log. "
        "(verified: no `config IP_NF_TARGET_ULOG` in net/ipv4/netfilter/Kconfig "
        "on 4.19.195; NF_LOG-based logging via CONFIG_NETFILTER_XT_TARGET_NFLOG "
        "is the replacement and is already in OPTIONAL_NON_GKI.)"
    ),
    "CONFIG_ANDROID_PARANOID_NETWORK": (
        "4.19 Xiaomi forks (e.g. sw-ng, vendor-modified) may strip the "
        "ANDROID_PARANOID_NETWORK symbol entirely. Since this entry requests "
        "`=n` (we want to disable the per-app network permission), absence "
        "of the symbol is functionally equivalent to our intent: the "
        "paranoid network check is not compiled in, so it cannot be enabled. "
        "Skipping here is therefore safe and a no-op. "
        "(Verified on sw-ng 4.19.325: no ANDROID_PARANOID_NETWORK in any "
        "Kconfig*. Same symbol IS present on stock kernels like rave44 "
        "4.4.302 and stormbreaker 4.19.195, so the symbol is not universally "
        "absent — only on stripped vendor forks.)"
    ),
}


# Cache Kconfig symbol presence per src_path to avoid repeated scans
_KCONFIG_SYMBOL_CACHE: dict = {}


def kconfig_scan_files(src_path):
    """Return list of Kconfig / Kconfig.* files under src_path."""
    cache_key = str(src_path.resolve())
    if cache_key in _KCONFIG_SYMBOL_CACHE and isinstance(_KCONFIG_SYMBOL_CACHE[cache_key], list):
        return _KCONFIG_SYMBOL_CACHE[cache_key]
    kcfiles = []
    try:
        # Limit depth to keep it fast on huge trees
        for p in src_path.rglob("Kconfig*"):
            # Only Kconfig (driver/kdb/Kconfig) — but match patterns like Kconfig.foo and Kconfig
            # as well as plain Kconfig. Common practice: Kconfig or Kconfig.<subdir>
            if p.is_file() and p.parent.name not in (".git",):
                kcfiles.append(p)
    except Exception:
        pass
    _KCONFIG_SYMBOL_CACHE[cache_key] = kcfiles
    return kcfiles


def kconfig_has_symbol(src_path, symbol_name):
    """Return True if `symbol_name` (CONFIG_XXX or XXX) is declared in any Kconfig* under src_path.
    Uses a regex that matches:
        config <NAME>
    at line start (after optional whitespace).
    Cached per src_path."""
    cache_key = (str(src_path.resolve()), symbol_name)
    if cache_key in _KCONFIG_SYMBOL_CACHE:
        return _KCONFIG_SYMBOL_CACHE[cache_key]
    # Strip CONFIG_ prefix to match Kconfig's `config FOO` / `menuconfig FOO` syntax
    bare = symbol_name[len("CONFIG_"):] if symbol_name.startswith("CONFIG_") else symbol_name
    # Match either `config FOO` or `menuconfig FOO` (Kconfig syntax)
    pat = re.compile(r"^\s*(?:menu)?config\s+" + re.escape(bare) + r"\s*$", re.MULTILINE)
    found = False
    for kf in kconfig_scan_files(src_path):
        try:
            text = kf.read_text(errors="ignore")
        except Exception:
            continue
        if pat.search(text):
            found = True
            break
    _KCONFIG_SYMBOL_CACHE[cache_key] = found
    return found


def resolve_symbol_for_kernel(src_path, cfg_name, allow_skip=False):
    """Resolve a desired CONFIG_XXX to an actually-existing symbol.
    Returns:
        (chosen_cfg, was_fallback, log_notes)
    where chosen_cfg may equal cfg_name, be a fallback, or be None.
    Raises SymbolResolutionError if no symbol can be resolved and the
    symbol is mandatory (allow_skip=False) AND not in VERIFIED_UNSUPPORTED.
    """
    notes = []
    attempted = []  # ordered list of symbols tried

    # Step 1: primary
    attempted.append(cfg_name)
    if kconfig_has_symbol(src_path, cfg_name):
        return cfg_name, False, notes

    notes.append(f"symbol '{cfg_name}' not declared in any Kconfig")

    # Step 2-4: walk all fallback chains (multilevel)
    chains = FALLBACK_SYMBOLS.get(cfg_name, [])
    # Normalize: accept legacy flat-list FALLBACK_SYMBOLS entries too
    # (legacy: list of strings => treated as a single chain)
    normalized_chains = []
    for ch in chains:
        if isinstance(ch, str):
            normalized_chains.append([ch])
        else:
            normalized_chains.append(list(ch))

    for chain_idx, chain in enumerate(normalized_chains):
        for fb in chain:
            attempted.append(fb)
            if kconfig_has_symbol(src_path, fb):
                notes.append(
                    f"fallback chain #{chain_idx+1}: using '{fb}' "
                    f"instead of '{cfg_name}'"
                )
                return fb, True, notes
            notes.append(f"fallback candidate '{fb}' also not declared")

    # Step 5: chain exhausted
    if cfg_name in VERIFIED_UNSUPPORTED:
        note = (f"symbol '{cfg_name}' verified unsupported: "
                f"{VERIFIED_UNSUPPORTED[cfg_name]} -> SKIP (explicit)")
        notes.append(note)
        return None, False, notes

    if allow_skip:
        notes.append(
            f"all fallbacks exhausted for '{cfg_name}' but --allow-skip "
            f"is set -> SKIP"
        )
        return None, False, notes

    # Strict: throw so the user investigates.
    raise SymbolResolutionError(cfg_name, attempted)


def modify_config_line(line: str, value: str) -> str:
    """Replace value in a config line, preserving whitespace and comments in line.
    Handles:
      CONFIG_X=y  -> CONFIG_X=<value>
      # CONFIG_X is not set  -> # CONFIG_X is not set (if value=n, keep as is)
      # CONFIG_X=y  -> # CONFIG_X=y (adjust)
    Actually for disabled (n), standard is '# CONFIG_X is not set'.
    For enabled (y), standard is 'CONFIG_X=y'.
    We'll follow kernel defconfig convention strictly.
    """
    stripped = line.strip()
    # Extract config name regardless of comment/active state
    name = None
    if stripped.startswith("#"):
        # Could be '# CONFIG_X is not set' or '# CONFIG_X=y'
        inner = stripped.lstrip("#").strip()
        name = inner.split("=", 1)[0].split()[0] if "=" in inner else inner.split()[0]
    else:
        name = stripped.split("=", 1)[0]
    if value == "n":
        return line.replace(stripped, f"# {name} is not set")
    else:
        return line.replace(stripped, f"{name}={value}")


def apply_defconfig_changes(path: Path, configs: list[tuple[str, str, str]], src_path: Path = None, dry_run: bool = False, allow_skip: bool = False) -> list[dict]:
    """Apply a list of (CONFIG, value, group_name) to defconfig.
    Returns list of applied changes (each dict with key/value/action/group).
    Idempotent: skips if already correct.
    """
    if dry_run:
        log("Dry-run: would check/edit defconfig but no file will be written.")
    if src_path is None:
        src_path = path.parent.parent.parent  # assume .../arch/arm64/configs
    lines = read_defconfig(path)
    applied = []
    for cfg_name, cfg_value, group in configs:
        # Dynamic Kconfig symbol resolution (no hardcode per-kernel).
        # By default this raises SymbolResolutionError for mandatory symbols
        # with no fallback; pass allow_skip=True to override (dev mode).
        chosen, was_fallback, notes = resolve_symbol_for_kernel(
            src_path, cfg_name, allow_skip=allow_skip
        )
        for note in notes:
            log(note, "verbose")
        if chosen is None:
            applied.append({"key": cfg_name, "value": cfg_value, "action": "skipped-missing", "group": group, "notes": notes})
            continue
        if was_fallback:
            log(f"resolved '{cfg_name}' -> '{chosen}' (fallback)", "info")
        cfg_name = chosen
        idx = find_config_line(lines, cfg_name)
        current_line = lines[idx] if idx >= 0 else None
        current_value = None
        if current_line is not None:
            stripped = current_line.strip()
            if stripped.startswith("#"):
                # Disabled or commented
                # If value is n and it's disabled already -> skip
                # If value is y but disabled -> enable
                # If value is n but enabled -> disable
                m_name = re.search(r"#\s*(CONFIG_[A-Z_]+)", stripped)
                if m_name:
                    actual_name = m_name.group(1)
                    if actual_name == cfg_name:
                        # Check if 'is not set'
                        is_disabled = "is not set" in stripped
                        if cfg_value == "n" and is_disabled:
                            current_value = "n"
                        elif cfg_value == "y" and is_disabled:
                            current_value = "disabled"
                        elif cfg_value == "n" and not is_disabled:
                            # enabled when should be disabled? rare
                            current_value = "y"
                        else:
                            current_value = cfg_value if cfg_value == "n" else "y"
                    else:
                        current_value = None
            else:
                # Active line
                parts = stripped.split("=")
                if len(parts) == 2 and parts[0].strip() == cfg_name:
                    current_value = parts[1].strip()
                else:
                    current_value = None
        else:
            current_value = None

        if current_value == cfg_value:
            # Already correct
            continue

        if not dry_run:
            # Modify or insert
            if idx >= 0:
                new_line = modify_config_line(lines[idx], cfg_value)
                lines[idx] = new_line
                applied.append({"key": cfg_name, "value": cfg_value, "action": "modified", "line": idx, "group": group})
            else:
                # Append at end (with group comment header if group changes)
                # For simplicity, append a blank line and the config line.
                # To keep file clean, we won't add extra comments.
                new_line_str = f"CONFIG_{cfg_name.split('_', 1)[1]}={cfg_value}" if False else f"{cfg_name}={cfg_value}"
                # Actually cfg_name is full CONFIG_... name
                new_line_str = f"{cfg_name}={cfg_value}" if cfg_value != "n" else f"# {cfg_name} is not set"
                # But if it should be disabled (n), standard defconfig format is '# CONFIG_X is not set'
                # Already handled by modify_config_line logic for insertion
                if cfg_value == "n":
                    new_line_str = f"# {cfg_name} is not set"
                else:
                    new_line_str = f"{cfg_name}={cfg_value}"
                # Append at the very end of file (before any trailing blank lines if clean)
                # To keep clean, insert before last trailing blank lines.
                # For simplicity: append with a comment header if new group.
                # We will just append it directly.
                # Find last non-empty line index
                last_non_empty = len(lines) - 1
                while last_non_empty >= 0 and lines[last_non_empty].strip() == "":
                    last_non_empty -= 1
                insert_pos = last_non_empty + 1
                # Add a blank line before new config if file doesn't end with blank
                if insert_pos < len(lines) and lines[insert_pos - 1].strip() != "":
                    lines.insert(insert_pos, "")
                    insert_pos += 1
                # Insert the new config line
                lines.insert(insert_pos, new_line_str + "\n")
                # Update index tracking: we don't track inserted lines (simple approach)
                applied.append({"key": cfg_name, "value": cfg_value, "action": "added", "line": insert_pos, "group": group})
        # After processing all configs, write back the file (if not dry-run)
        if not dry_run:
            write_defconfig(path, lines)
    else:
        # In dry-run, just compute what would change
        for cfg_name, cfg_value, group in configs:
            idx = find_config_line(lines, cfg_name)
            current_line = lines[idx] if idx >= 0 else None
            current_value = None
            if current_line is not None:
                stripped = current_line.strip()
                if stripped.startswith("#"):
                    m_name = re.search(r"#\s*(CONFIG_[A-Z_]+)", stripped)
                    if m_name and m_name.group(1) == cfg_name:
                        is_disabled = "is not set" in stripped
                        if cfg_value == "n" and is_disabled:
                            current_value = "n"
                        elif cfg_value == "y" and is_disabled:
                            current_value = "disabled"
                        else:
                            current_value = cfg_value if cfg_value == "n" else "y"
                else:
                    parts = stripped.split("=")
                    if len(parts) == 2 and parts[0].strip() == cfg_name:
                        current_value = parts[1].strip()
            if current_value != cfg_value:
                applied.append({"key": cfg_name, "value": cfg_value, "action": "would-change", "group": group, "line": idx})
    return applied


def resolve_patches_for_kernel(src_path: Path, is_gki_flag: bool) -> list[Path]:
    if is_gki_flag:
        version = get_kernel_version(src_path)
        variant, mq = detect_gki_variant(src_path)
        patches = []
        if variant == "above_612":
            # Try 6.12 patch; fall back to below if file missing
            p = PATCH_GKI_ABOVE_612[0]
            if p.exists():
                patches.append(p)
            else:
                log(f"GKI 6.12+ patch not found at {p}; using below-6.12 fallback", "warn")
                # Fallback: try below-612 primary
                p_fallback = PATCH_GKI_BELOW_612[0]
                if p_fallback.exists():
                    patches.append(p_fallback)
        else:
            # Try primary 6_7_8 variant
            primary = PATCH_GKI_BELOW_612[0]
            if primary.exists():
                patches.append(primary)
            else:
                # Fallback to alt variants
                for alt in PATCH_GKI_BELOW_612_ALT_SYSVIPC_VARIANTS:
                    if alt.exists():
                        patches.append(alt)
                        break
            if mq:
                # Apply mqueue fix for <= 5.10 GKI
                mq_patch = PATCH_GKI_BELOW_612_MQUEUE[0]
                if mq_patch.exists():
                    patches.append(mq_patch)
                else:
                    log("GKI mqueue patch not found; continuing.", "warn")
        return patches
    else:
        patches = []
        for p in PATCH_NON_GKI:
            if p.exists():
                patches.append(p)
            else:
                log(f"Non-GKI patch not found: {p}", "warn")
        return patches


# ==============================================
#  PATCH APPLICATION (idempotent, safe)
# ==============================================

def apply_patch(patch_path: Path, src_path: Path, dry_run: bool = False) -> dict:
    """Apply a single patch using `patch -p1` command in src_path.
    Returns result dict with keys: applied, skipped, failed, message.
    """
    # Check if patch file exists
    if not patch_path.exists():
        return {"applied": False, "skipped": False, "failed": True, "message": f"Patch file not found: {patch_path}"}

    # Build command: change to src_path and run patch -p1 -i <patch_path>
    cmd = ["patch", "-p1", "-i", str(patch_path.resolve()), "--quiet"]
    # We use a temporary working directory approach: set cwd=src_path
    try:
        result = subprocess.run(
            cmd,
            cwd=str(src_path.resolve()),
            capture_output=True,
            text=True,
            timeout=120,
        )
    except Exception as e:
        return {"applied": False, "skipped": False, "failed": True, "message": str(e)}

    if result.returncode == 0:
        return {"applied": True, "skipped": False, "failed": False, "message": "Applied cleanly."}
    elif result.returncode == 1:
        # Patch may have been partially applied or refused; check stdout/stderr for clues.
        out = result.stdout + result.stderr
        # If it says "Reversed (or previously applied) patch detected" or similar -> skip
        # If it says "Hunk #1 succeeded" but then "Hunk #2 failed" -> partial fail.
        if "already applied" in out.lower() or "reversed" in out.lower():
            return {"applied": False, "skipped": True, "failed": False, "message": "Already applied; skipped."}
        return {"applied": False, "skipped": False, "failed": True, "message": f"Patch failed: {out[:500]}"}
    else:
        return {"applied": False, "skipped": False, "failed": True, "message": f"Unexpected return code {result.returncode}: {result.stderr}"}


def apply_all_patches(src_path: Path, is_gki_flag: bool, dry_run: bool, skip_patch: bool) -> dict:
    if skip_patch:
        return {"results": [], "applied": 0, "skipped": 0, "failed": 0}
    patches = resolve_patches_for_kernel(src_path, is_gki_flag)
    results = []
    for p in patches:
        if dry_run:
            # In dry-run, check if file exists and simulate (don't actually run patch)
            results.append({"file": str(p), "applied": False, "skipped": False, "message": "Dry-run: would attempt.", "dry_run": True})
            continue
        res = apply_patch(p, src_path, dry_run=False)
        res["file"] = str(p.name)
        results.append(res)
    # Compute aggregate
    applied_count = sum(1 for r in results if r.get("applied"))
    skipped_count = sum(1 for r in results if r.get("skipped"))
    failed_count = sum(1 for r in results if r.get("failed"))
    return {
        "results": results,
        "applied": applied_count,
        "skipped": skipped_count,
        "failed": failed_count,
    }


def backup_defconfig(path: Path) -> Path:
    """Create a .bak copy of defconfig if it does not already exist.
    Caller decides whether to invoke this (opt-in via --backup)."""
    backup_path = Path(str(path) + ".bak")
    if not backup_path.exists():
        shutil.copy2(path, backup_path)
        log(f"Backup created: {backup_path}", "info")
    else:
        log(f"Backup exists (not overwritten): {backup_path}", "info")
    return backup_path


# ==============================================
#  MAIN
# ==============================================

def main():
    parser = argparse.ArgumentParser(
        description="Install Droidspaces OSS kernel configurations and patches.",
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument("kernel_source", nargs='?', default='.', type=str, help="Path to kernel source directory (contains Makefile) (default: current working directory)")
    parser.add_argument("defconfig_path", type=str, help="Path to defconfig file relative to <kernel_source>/arch/arm64/configs (e.g. vendor/whyred-perf_defconfig)")
    parser.add_argument("--include-optional", action="store_true", help="Include optional configurations (UFW, Fail2ban, USER_NS, TMPFS_XATTR, TMPFS_POSIX_ACL, etc.)")
    parser.add_argument("--dry-run", action="store_true", help="Show what would be done without making changes.")
    parser.add_argument("--skip-patch", action="store_true", help="Skip patching step, only configure defconfig.")
    parser.add_argument("--verbose", "-v", action="store_true", help="Verbose Kconfig resolution notes (use when adding fallbacks).")
    parser.add_argument("--allow-skip-unresolved", action="store_true",
                        help="If a mandatory symbol cannot be resolved and is not "
                             "in VERIFIED_UNSUPPORTED, skip it instead of erroring. "
                             "Use only during initial development; the strict default "
                             "forces you to add a fallback or explicit verification.")
    parser.add_argument("--backup", action="store_true",
                        help="Create a .bak copy of the defconfig before editing. "
                             "Backup is opt-in: by default no backup is created.")
    args = parser.parse_args()
    global _VERBOSE
    _VERBOSE = args.verbose

    # Validate paths
    src_path = Path(args.kernel_source).resolve()
    
    # Resolve defconfig_path relative to <kernel_source>/arch/arm64/configs
    defconfig_base = src_path / "arch" / "arm64" / "configs"
    defconfig_path = defconfig_base / args.defconfig_path

    if not src_path.is_dir():
        print(f"[ERROR] Kernel source directory does not exist: {src_path}", file=sys.stderr)
        sys.exit(1)

    if not defconfig_path.is_file():
        print(f"[ERROR] Defconfig file does not exist: {defconfig_path}", file=sys.stderr)
        sys.exit(2)

    # Detect kernel version and GKI status
    try:
        kernel_version = get_kernel_version(src_path)
    except SystemExit as e:
        print(str(e), file=sys.stderr)
        sys.exit(3)

    log(f"Detected kernel version: {'.'.join(str(x) for x in kernel_version)}")
    gki = is_gki(src_path)
    log(f"GKI mode detected: {gki}")

    # Resolve patches for this kernel (manual engine, robust across versions)
    if _manual_engine is not None:
        patch_results = _manual_engine.apply_all_manual_patches(src_path, gki, args.dry_run, args.skip_patch)
    else:
        patch_results = apply_all_patches(src_path, gki, args.dry_run, args.skip_patch)

    # Print patch results clearly
    for res in patch_results.get("results", []):
        status_symbol = "[OK]" if res.get("applied") else ("[SKIP]" if res.get("skipped") else "[FAIL]")
        msg = res.get("message", "")
        print(f"{status_symbol} Patch: {res.get('file', '?')} -> {msg}")

    if patch_results.get("failed", 0) > 0:
        log("Some patches failed. Review above.", "warn")

    # Select configurations based on mode and option
    configs_to_apply: list = []
    if gki:
        # GKI mode: only use mandatory GKI configs (and optional if flag)
        configs_to_apply.extend(MANDATORY_GKI)
        if args.include_optional:
            configs_to_apply.extend(OPTIONAL_GKI)
    else:
        # Non-GKI mode: use full mandatory list (and optional if flag)
        configs_to_apply.extend(MANDATORY_NON_GKI)
        if args.include_optional:
            configs_to_apply.extend(OPTIONAL_NON_GKI)

    # Apply defconfig edits
    # Backup defconfig (opt-in via --backup; dry-run never writes)
    if args.backup and not args.dry_run:
        backup_defconfig(defconfig_path)
    elif not args.backup and not args.dry_run:
        log("Backup skipped (use --backup to create a .bak copy)", "info")

    changes = apply_defconfig_changes(
        defconfig_path, configs_to_apply,
        src_path=src_path, dry_run=args.dry_run,
        allow_skip=args.allow_skip_unresolved,
    )

    # Print results
    if changes:
        modified = [c for c in changes if c["action"] in ("modified", "added") and c.get("dry_run") is not True]
        dry_changes = [c for c in changes if c.get("action") in ("modified", "added") and c.get("dry_run") is True]
        actual_mods = [c for c in changes if c.get("action") in ("modified", "added") and c.get("dry_run") is not True or (not args.dry_run and "key" in c)]
        # For simplicity: list all changes
        groups_applied = sorted({c.get("group", "Other") for c in changes})
        log(f"Configurations applied (groups): {', '.join(groups_applied)}")
        for c in changes:
            action_tag = "[DRY]" if args.dry_run and ("key" in c) else ("[ADD]" if c.get("action") == "added" else "[MOD]")
            log(f"{action_tag} {c.get('key', '?')} = {c.get('value', '?')} (group: {c.get('group', '?')})")
    else:
        log("No configuration changes needed (already set correctly).")

    # Final summary
    total_patches = len(patch_results.get("results", []))
    total_applied_patches = patch_results.get("applied", 0)
    total_failed_patches = patch_results.get("failed", 0)
    total_configs = len(configs_to_apply)
    total_config_changes = len(changes)

    log(f"Summary:")
    log(f"  Kernel version: {'.'.join(str(x) for x in kernel_version)}")
    log(f"  GKI mode: {gki}")
    log(f"  Optional included: {args.include_optional}")
    log(f"  Skip patch: {args.skip_patch}")
    log(f"  Patches: {total_applied_patches}/{total_patches} applied; {total_failed_patches} failed.")
    log(f"  Configs checked: {total_configs}; modified/added: {total_config_changes}.")
    log(f"  Dry-run mode: {args.dry_run}")
    if args.dry_run:
        log("No files were modified (dry-run mode).")
    else:
        log("Installation complete.")
        log(f"Defconfig edited: {defconfig_path}")


if __name__ == "__main__":
    main()
