#!/usr/bin/env bash
# ksu-install - KernelSU Original (non-GKI) Integration Script
# Production-ready, robust implementation following official KernelSU documentation
#
# This script integrates KernelSU (original/tiann) into non-GKI kernel source trees.
# It does NOT use setup.sh - instead, it uses a git submodule at external/KernelSU.
#
# Usage: ksu-install [options] <method> <kernel_source_dir> [defconfig_path]
#   method: manual | kprobe
#   kernel_source_dir: path to kernel source tree (must be writable)
#   defconfig_path: required for full integration, optional for standalone backport mode

set -euo pipefail

# ============================================================================
# Constants & Configuration
# ============================================================================
readonly SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_VERSION="1.0.0"
readonly KSU_BRANCH="main"
readonly KSU_TAG="v0.9.5"  # Last version supporting non-GKI (per official docs)

# Repo root (where external/KernelSU submodule lives)
# Script is at scripts/ksu-install, so root is parent of script dir
readonly LAVENDER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly KSU_SUBMODULE_PATH="$LAVENDER_ROOT/external/KernelSU"
readonly KSU_KERNEL_SOURCE="$KSU_SUBMODULE_PATH/kernel"

# Options / Flags
SKIP_KSU_FETCH=0
BACKPORT_PATH_UMOUNT=0
BACKPORT_DEVPTS=0
BACKPORT_SAFE_MODE=0
BACKPORT_ALL=0
ANY_BACKPORT_SET=0

# Required kernel configs for kprobe method (KernelSU original)
readonly KPROBE_CONFIGS=(
    "CONFIG_KPROBES=y"
    "CONFIG_HAVE_KPROBES=y"
    "CONFIG_KPROBE_EVENTS=y"
    "CONFIG_KSU=y"
)

# Required kernel configs for manual method
readonly MANUAL_CONFIGS=(
    "CONFIG_KSU=y"
)

# Files to patch for manual integration (KernelSU original: 4 files, NO reboot.c)
readonly MANUAL_PATCH_FILES=(
    "fs/exec.c"
    "fs/open.c"
    "fs/read_write.c"
    "fs/stat.c"
)

# Backport definitions: file path + verification hook
readonly BACKPORT_PATH_UMOUNT_FILE="fs/namespace.c"
readonly BACKPORT_PATH_UMOUNT_HOOK="path_umount"

readonly BACKPORT_DEVPTS_FILE="fs/devpts/inode.c"
readonly BACKPORT_DEVPTS_HOOK="ksu_handle_devpts"

readonly BACKPORT_SAFE_MODE_FILE="drivers/input/input.c"
readonly BACKPORT_SAFE_MODE_HOOK="ksu_handle_input_handle_event"

# ============================================================================
# Logging & Output Functions
# ============================================================================
log_info()    { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
log_success() { printf '\033[1;32m[OK]\033[0m   %s\n' "$*"; }
log_warn()    { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
log_error()   { printf '\033[1;31m[ERROR]\033[0m %s\n' "$*" >&2; }
log_debug()   { [[ "${DEBUG:-0}" -eq 1 ]] && printf '\033[1;36m[DEBUG]\033[0m %s\n' "$*"; return 0; }
log_step()    { printf '\n\033[1;35m>>> %s\033[0m\n' "$*"; }

die() {
    log_error "$*"
    exit 1
}

# ============================================================================
# Patch Helper Functions
# ============================================================================
detect_indent() {
    local file="$1"
    local line="$2"
    local indent=""
    local char
    char=$(sed -n "${line}p" "$file" | sed -n 's/^\([ \t]*\).*/\1/p')
    if [[ -n "$char" ]]; then
        indent="$char"
    else
        indent="    "
    fi
    echo "$indent"
}

find_function_start() {
    local file="$1"
    local pattern="$2"
    local start_line="${3:-1}"
    awk -v start="$start_line" -v pat="$pattern" '
        NR >= start && $0 ~ pat { print NR; exit }
    ' "$file"
}

find_function_end() {
    local file="$1"
    local start_line="$2"
    local pattern="$3"
    awk -v start="$start_line" -v pat="$pattern" '
        NR >= start && $0 ~ pat { print NR; exit }
    ' "$file"
}

find_next_line_matching() {
    local file="$1"
    local start_line="$2"
    local pattern="$3"
    awk -v start="$start_line" -v pat="$pattern" '
        NR > start && $0 ~ pat { print NR; exit }
    ' "$file"
}

insert_before_line() {
    local file="$1"
    local line_num="$2"
    local content="$3"
    local indent="${4:-}"
    local tmp_file
    tmp_file=$(mktemp)
    printf '%s\n' "$content" > "$tmp_file"
    if [[ $line_num -le 1 ]]; then
        local out_file
        out_file=$(mktemp)
        cat "$tmp_file" "$file" > "$out_file"
        mv "$out_file" "$file"
    else
        sed -i "$((line_num - 1))r $tmp_file" "$file"
    fi
    rm -f "$tmp_file"
}

insert_after_line() {
    local file="$1"
    local line_num="$2"
    local content="$3"
    local indent="${4:-}"
    local tmp_file
    tmp_file=$(mktemp)
    printf '%s\n' "$content" > "$tmp_file"
    sed -i "${line_num}r $tmp_file" "$file"
    rm -f "$tmp_file"
}

# Tries multiple patterns and returns the first matching line number.
# Always returns 0 (empty output if no match) to be safe with set -e.
patch_with_fallback() {
    local file="$1"
    local patterns=("${@:2}")
    local result=""

    for pattern in "${patterns[@]}"; do
        result=$(find_function_start "$file" "$pattern")
        if [[ -n "$result" ]]; then
            echo "$result"
            return 0
        fi
    done
    echo ""
    return 0
}

verify_patch_applied() {
    local file="$1"
    local hook_pattern="$2"
    grep -q "$hook_pattern" "$file"
}

backup_and_verify() {
    local file="$1"
    local backup_pattern="${file}.ksu-backup.*"
    local existing_backup
    existing_backup=$(ls -t ${backup_pattern} 2>/dev/null | head -1)

    if [[ -n "$existing_backup" ]]; then
        log_debug "Using existing backup: $existing_backup"
        echo "$existing_backup"
        return 0
    fi

    local backup
    backup=$(backup_file "$file")
    [[ -f "$backup" ]] || { log_error "Failed to create backup for $file"; return 1; }
    echo "$backup"
    return 0
}

# ============================================================================
# Utility Functions
# ============================================================================
get_backport_list() {
    local list=()
    [[ $BACKPORT_PATH_UMOUNT -eq 1 ]] && list+=("path_umount")
    [[ $BACKPORT_DEVPTS -eq 1 ]] && list+=("devpts")
    [[ $BACKPORT_SAFE_MODE -eq 1 ]] && list+=("safe_mode")
    if [[ ${#list[@]} -eq 0 ]]; then
        echo "none"
    else
        echo "${list[*]}"
    fi
}

show_usage() {
    cat <<EOF
Usage: $SCRIPT_NAME [options] <method> <kernel_source_dir> [defconfig_path]

Integrate KernelSU (original/tiann, non-GKI) into a kernel source tree.

Arguments:
  method            Integration method: 'manual' or 'kprobe'
  kernel_source_dir Path to kernel source tree (must exist and be writable)
  defconfig_path    Defconfig filename (relative to kernel_source/arch/arm64/configs/ or absolute)
                    Optional when --backport-* flags are used (standalone mode)

Options:
  --skip-ksu-fetch          Skip fetching/updating KernelSU submodule (use existing)

Standalone Backport Options (each can work independently):
  --backport-path_umount    Backport path_umount from kernel 5.9 → fs/namespace.c
                            Fixes "Umount module" feature on pre-5.9 / pre-GKI kernels
  --backport-devpts         Patch fs/devpts/inode.c → fixes "pm execution failed" in terminal
  --backport-safe-mode      Patch drivers/input/input.c → enables KernelSU Safe Mode
  --backport-all            Apply ALL three backports above

  When any --backport-* flag is set, the script enters STANDALONE MODE:
  only the specified backport(s) are applied. All other steps are skipped
  (KSU source fetch, manual hooks, defconfig updates). defconfig_path becomes optional.

  Multiple --backport-* flags can be combined (e.g. --backport-devpts --backport-safe-mode).

Methods:
  kprobe   - Uses kprobe hooks (recommended if kprobe works on your kernel)
             Requires: CONFIG_KPROBES, CONFIG_HAVE_KPROBES, CONFIG_KPROBE_EVENTS
  manual   - Direct source code patches (for kernels where kprobe is broken
             or kernel version < 4.8)
             Patches 4 files: fs/exec.c, fs/open.c, fs/read_write.c, fs/stat.c

KernelSU Source:
  Uses external/KernelSU git submodule (main branch, pinned to v0.9.5 tag).
  Submodule is auto-initialized on first run. Subsequent runs update it.
  Last supported version for non-GKI: v0.9.5 (v1.0+ dropped non-GKI support).

Important:
  - If using manual integration, you MUST disable CONFIG_KPROBES in defconfig
    to prevent accidental Safe Mode triggers (volume down button after boot).
  - For kernels < 5.9, use --backport-path_umount to enable "Umount module" feature.
  - For kernels < 4.17, the script automatically falls back from do_faccessat to
    SYSCALL_DEFINE3(faccessat), and from vfs_statx to vfs_fstatat.

Examples:
  # Full integration
  $SCRIPT_NAME kprobe /path/to/kernel vendor/lavender_defconfig
  $SCRIPT_NAME manual /path/to/kernel lavender_defconfig
  $SCRIPT_NAME --skip-ksu-fetch manual /path/to/kernel vendor/lavender-perf_defconfig

  # Standalone backport mode (no defconfig needed)
  $SCRIPT_NAME manual /path/to/kernel --backport-path_umount
  $SCRIPT_NAME manual /path/to/kernel --backport-devpts
  $SCRIPT_NAME manual /path/to/kernel --backport-safe-mode
  $SCRIPT_NAME manual /path/to/kernel --backport-all
  $SCRIPT_NAME manual /path/to/kernel --backport-devpts --backport-safe-mode

Notes:
  - Kernel source must be buildable (bootable kernel from source)
  - For manual method: patches 4 kernel files with KSU hooks
  - For kprobe method: enables required kprobe configs in defconfig
  - --backport-* flags = standalone mode (only specified patches applied)
  - Run from kernel source root or provide absolute paths
EOF
}

validate_args() {
    [[ $# -ge 2 ]] || { show_usage; die "Expected at least 2 arguments, got $#"; }

    # Parse optional flags first (so we know if we're in standalone mode)
    local args=()
    for arg in "$@"; do
        case "$arg" in
            --skip-ksu-fetch) SKIP_KSU_FETCH=1 ;;
            --backport-path_umount) BACKPORT_PATH_UMOUNT=1 ;;
            --backport-devpts) BACKPORT_DEVPTS=1 ;;
            --backport-safe-mode) BACKPORT_SAFE_MODE=1 ;;
            --backport-all) BACKPORT_ALL=1 ;;
            *) args+=("$arg") ;;
        esac
    done

    # If --backport-all is set, enable all individual backports
    if [[ $BACKPORT_ALL -eq 1 ]]; then
        BACKPORT_PATH_UMOUNT=1
        BACKPORT_DEVPTS=1
        BACKPORT_SAFE_MODE=1
    fi

    # Check if any backport flag is set (for standalone mode detection)
    if [[ $BACKPORT_PATH_UMOUNT -eq 1 || $BACKPORT_DEVPTS -eq 1 || $BACKPORT_SAFE_MODE -eq 1 ]]; then
        ANY_BACKPORT_SET=1
    fi

    # In standalone mode (backport flags set), defconfig_path is optional
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        [[ ${#args[@]} -ge 2 && ${#args[@]} -le 3 ]] \
            || { show_usage; die "Standalone backport mode expects 2-3 arguments (method, kernel_source_dir, [defconfig_path]), got ${#args[@]}"; }
    else
        [[ ${#args[@]} -eq 3 ]] \
            || { show_usage; die "Expected 3 arguments (method, kernel_source_dir, defconfig_path), got ${#args[@]}"; }
    fi

    METHOD="${args[0]}"
    KERNEL_SRC="$(realpath "${args[1]}")"

    [[ -d "$KERNEL_SRC" ]] || die "Kernel source directory not found: $KERNEL_SRC"
    [[ -w "$KERNEL_SRC" ]] || die "Kernel source directory not writable: $KERNEL_SRC"

    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        # Standalone backport mode: defconfig_path is optional (ignored if provided)
        DEFCONFIG_PATH=""
        if [[ ${#args[@]} -eq 3 ]]; then
            local defconfig_input="${args[2]}"
            if [[ "$defconfig_input" = /* ]]; then
                DEFCONFIG_PATH="$defconfig_input"
            else
                DEFCONFIG_PATH="$KERNEL_SRC/arch/arm64/configs/$defconfig_input"
            fi
            log_debug "Defconfig provided (ignored in standalone mode): $DEFCONFIG_PATH"
        fi
        log_info "Standalone backport mode"
        log_info "  Backports to apply: $(get_backport_list)"
        log_info "  Skipping: KSU source fetch, manual patches, defconfig updates"
    else
        # Normal mode: validate method and defconfig
        [[ "$METHOD" == "manual" || "$METHOD" == "kprobe" ]] \
            || die "Invalid method: '$METHOD'. Must be 'manual' or 'kprobe'"

        local defconfig_input="${args[2]}"
        if [[ "$defconfig_input" = /* ]]; then
            DEFCONFIG_PATH="$defconfig_input"
        else
            DEFCONFIG_PATH="$KERNEL_SRC/arch/arm64/configs/$defconfig_input"
        fi

        [[ -f "$DEFCONFIG_PATH" ]] || die "Defconfig not found: $DEFCONFIG_PATH"
        [[ -w "$DEFCONFIG_PATH" ]] || die "Defconfig not writable: $DEFCONFIG_PATH"
    fi

    log_debug "Method: $METHOD"
    log_debug "Kernel source: $KERNEL_SRC"
    log_debug "Defconfig: ${DEFCONFIG_PATH:-<none>}"
    log_debug "Skip KSU fetch: $SKIP_KSU_FETCH"
    log_debug "Backport path_umount: $BACKPORT_PATH_UMOUNT"
    log_debug "Backport devpts: $BACKPORT_DEVPTS"
    log_debug "Backport safe_mode: $BACKPORT_SAFE_MODE"
    log_debug "Any backport set: $ANY_BACKPORT_SET"
}

# ============================================================================
# Pre-flight Checks & Backup
# ============================================================================
check_prerequisites() {
    log_step "Checking prerequisites"

    local missing=()
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        # Standalone backport mode: only need text-processing tools
        for cmd in grep sed awk find; do
            command -v "$cmd" >/dev/null || missing+=("$cmd")
        done
    else
        # Full integration: need all tools including git for submodule
        for cmd in git make grep sed awk find; do
            command -v "$cmd" >/dev/null || missing+=("$cmd")
        done
    fi

    [[ ${#missing[@]} -eq 0 ]] || die "Missing required commands: ${missing[*]}"

    # Verify it's a kernel source tree
    [[ -f "$KERNEL_SRC/Makefile" && -f "$KERNEL_SRC/Kconfig" ]] \
        || die "Not a valid kernel source tree: $KERNEL_SRC"

    # In standalone mode, verify target backport files exist
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE" ]] \
                || die "namespace.c not found: $KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE"
        fi
        if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_DEVPTS_FILE" ]] \
                || die "devpts/inode.c not found: $KERNEL_SRC/$BACKPORT_DEVPTS_FILE"
        fi
        if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
            [[ -f "$KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE" ]] \
                || die "input.c not found: $KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE"
        fi
    fi

    log_success "Prerequisites satisfied"
}

backup_file() {
    local file="$1"
    local backup="${file}.ksu-backup.$(date +%Y%m%d_%H%M%S)"
    cp -p "$file" "$backup"
    log_debug "Backed up $file to $backup"
    echo "$backup"
}

restore_backup() {
    local file="$1"
    local backup_pattern="${file}.ksu-backup.*"
    local latest_backup
    latest_backup=$(ls -t ${backup_pattern} 2>/dev/null | head -1)
    if [[ -n "$latest_backup" && -f "$latest_backup" ]]; then
        cp -p "$latest_backup" "$file"
        log_warn "Restored $file from backup: $latest_backup"
    fi
}

# ============================================================================
# Pre-flight Detection
# ============================================================================
detect_existing_ksu() {
    log_step "Detecting existing KernelSU integration"

    local has_ksu_source=0
    local has_manual_patches=0
    local has_kprobe_configs=0
    local has_ksu_config=0
    local manual_patched_files=()
    local kprobe_configs_found=()
    local kprobe_configs_missing=()

    # Find drivers directory
    local driver_dir
    if [[ -d "$KERNEL_SRC/common/drivers" ]]; then
        driver_dir="common/drivers"
    elif [[ -d "$KERNEL_SRC/drivers" ]]; then
        driver_dir="drivers"
    else
        driver_dir="drivers"
    fi

    # Check KernelSU source (submodule) and symlink in kernel tree
    if [[ -d "$KSU_KERNEL_SOURCE" ]] && [[ -L "$KERNEL_SRC/$driver_dir/kernelsu" ]]; then
        has_ksu_source=1
        log_info "KernelSU source detected: $KSU_KERNEL_SOURCE (symlinked in $driver_dir/kernelsu)"
    fi

    # Check manual patches in kernel source (4 files for KSU original)
    for file in "${MANUAL_PATCH_FILES[@]}"; do
        local filepath="$KERNEL_SRC/$file"
        if [[ -f "$filepath" ]] && grep -q "ksu_handle_" "$filepath"; then
            manual_patched_files+=("$file")
            has_manual_patches=1
        fi
    done

    if [[ ${#manual_patched_files[@]} -gt 0 ]]; then
        log_info "Manual patches detected in: ${manual_patched_files[*]}"
    fi

    # Check defconfig for KSU config
    if grep -q "^CONFIG_KSU=y" "$DEFCONFIG_PATH"; then
        has_ksu_config=1
        log_info "CONFIG_KSU=y found in defconfig"
    fi

    # Check defconfig for kprobe configs
    for config in "${KPROBE_CONFIGS[@]}"; do
        local key="${config%%=*}"
        if grep -q "^${key}=y" "$DEFCONFIG_PATH"; then
            kprobe_configs_found+=("$key")
            has_kprobe_configs=1
        else
            kprobe_configs_missing+=("$key")
        fi
    done

    if [[ ${#kprobe_configs_found[@]} -gt 0 ]]; then
        log_info "Kprobe configs enabled: ${kprobe_configs_found[*]}"
    fi
    if [[ ${#kprobe_configs_missing[@]} -gt 0 ]]; then
        log_debug "Kprobe configs not set: ${kprobe_configs_missing[*]}"
    fi

    # Determine existing integration method
    local existing_method="none"
    if [[ $has_manual_patches -eq 1 && $has_kprobe_configs -eq 1 ]]; then
        existing_method="both (hybrid)"
        log_warn "Hybrid integration detected: manual patches + kprobe configs both present"
    elif [[ $has_manual_patches -eq 1 ]]; then
        existing_method="manual"
        log_info "Existing integration method: manual patches"
    elif [[ $has_kprobe_configs -eq 1 && $has_ksu_config -eq 1 ]]; then
        existing_method="kprobe"
        log_info "Existing integration method: kprobe"
    elif [[ $has_ksu_source -eq 1 ]]; then
        existing_method="source-only"
        log_info "KernelSU source present but no integration detected"
    fi

    # Warn if switching methods
    if [[ "$existing_method" != "none" && "$existing_method" != "source-only" ]]; then
        if [[ "$METHOD" == "manual" && "$existing_method" == "kprobe" ]]; then
            log_warn "Switching from kprobe to manual method"
            log_info "  - Kprobe configs will be disabled"
            log_info "  - Manual patches will be applied/verified on 4 kernel files"
        elif [[ "$METHOD" == "kprobe" && "$existing_method" == "manual" ]]; then
            log_warn "Switching from manual to kprobe method"
            log_info "  - Manual patches will remain in source (harmless but unused)"
            log_info "  - Kprobe configs will be enabled"
        fi
    fi

    export KSU_EXISTING_METHOD="$existing_method"
}

# ============================================================================
# KernelSU Source Integration (using external submodule)
# ============================================================================
fetch_ksu_source() {
    log_step "Setting up KernelSU from submodule (branch: $KSU_BRANCH, tag: $KSU_TAG)"

    # Ensure submodule exists and is initialized
    if [[ ! -d "$KSU_SUBMODULE_PATH/.git" && ! -f "$KSU_SUBMODULE_PATH/.git" ]]; then
        if [[ $SKIP_KSU_FETCH -eq 1 ]]; then
            die "KernelSU submodule not initialized at $KSU_SUBMODULE_PATH and --skip-ksu-fetch specified. Run 'git submodule update --init external/KernelSU' first."
        fi
        log_info "Initializing KernelSU submodule..."
        git -C "$LAVENDER_ROOT" submodule update --init --recursive external/KernelSU
    fi

    # Ensure we're on the main branch first
    local current_branch
    current_branch=$(git -C "$KSU_SUBMODULE_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    if [[ "$current_branch" != "$KSU_BRANCH" && "$current_branch" != "(HEAD detached at $KSU_TAG)" ]]; then
        if [[ "$current_branch" == "HEAD" ]]; then
            log_info "Submodule in detached HEAD state, switching to $KSU_BRANCH..."
        else
            log_info "Switching KernelSU to '$KSU_BRANCH' branch..."
        fi
        git -C "$KSU_SUBMODULE_PATH" checkout "$KSU_BRANCH" 2>/dev/null || \
            die "Failed to checkout '$KSU_BRANCH' branch in submodule"
    fi

    # Optionally update submodule (unless skipped)
    if [[ $SKIP_KSU_FETCH -eq 0 ]]; then
        log_info "Updating KernelSU submodule..."
        git -C "$KSU_SUBMODULE_PATH" stash 2>/dev/null || true
        git -C "$KSU_SUBMODULE_PATH" fetch origin 2>/dev/null || log_warn "Git fetch failed (network issue?), continuing with existing source"
        git -C "$KSU_SUBMODULE_PATH" pull origin "$KSU_BRANCH" 2>/dev/null || true
    else
        log_info "Skipping submodule update (--skip-ksu-fetch specified)"
    fi

    # Checkout the pinned tag (v0.9.5 - last non-GKI supported version)
    log_info "Checking out tag $KSU_TAG (last non-GKI supported version)..."
    git -C "$KSU_SUBMODULE_PATH" checkout "$KSU_TAG" 2>/dev/null || \
        log_warn "Failed to checkout $KSU_TAG tag. Ensure it exists: git -C $KSU_SUBMODULE_PATH fetch --tags"

    # Verify KernelSU source structure
    [[ -d "$KSU_KERNEL_SOURCE" ]] || die "KernelSU kernel source not found at $KSU_KERNEL_SOURCE"
    [[ -f "$KSU_KERNEL_SOURCE/Kconfig" ]] || die "KernelSU source incomplete - Kconfig missing"
    [[ -f "$KSU_KERNEL_SOURCE/core/init.c" ]] || die "KernelSU source incomplete - core/init.c missing"

    # Integrate into kernel source: symlink, Makefile, Kconfig
    integrate_ksu_into_kernel

    log_success "KernelSU source integrated from submodule (tag: $KSU_TAG)"
}

# Integrate KernelSU into kernel source tree (replaces setup.sh logic)
integrate_ksu_into_kernel() {
    log_step "Integrating KernelSU into kernel source tree"

    cd "$KERNEL_SRC"

    # Find drivers directory (GKI: common/drivers, traditional: drivers)
    local driver_dir
    if [[ -d "common/drivers" ]]; then
        driver_dir="common/drivers"
    elif [[ -d "drivers" ]]; then
        driver_dir="drivers"
    else
        die "Could not find drivers/ directory in kernel source"
    fi

    local driver_makefile="$driver_dir/Makefile"
    local driver_kconfig="$driver_dir/Kconfig"
    local kernelsu_symlink="$driver_dir/kernelsu"

    # Compute relative path from driver_dir to KernelSU kernel source
    local rel_path
    rel_path=$(realpath --relative-to="$(pwd)/$driver_dir" "$KSU_KERNEL_SOURCE")

    # 1. Create/update symlink: drivers/kernelsu -> external/KernelSU/kernel
    if [[ -L "$kernelsu_symlink" ]]; then
        local current_target
        current_target=$(readlink "$kernelsu_symlink")
        if [[ "$current_target" != "$rel_path" ]]; then
            log_info "Updating kernelsu symlink: $current_target -> $rel_path"
            rm "$kernelsu_symlink"
            ln -sf "$rel_path" "$kernelsu_symlink"
        else
            log_debug "kernelsu symlink already correct"
        fi
    elif [[ -e "$kernelsu_symlink" ]]; then
        die "$kernelsu_symlink exists but is not a symlink. Remove it manually first."
    else
        log_info "Creating kernelsu symlink -> $rel_path"
        ln -sf "$rel_path" "$kernelsu_symlink"
    fi

    # 2. Update drivers/Makefile: add obj-$(CONFIG_KSU) += kernelsu/
    if grep -q "kernelsu" "$driver_makefile"; then
        log_debug "Makefile already has kernelsu entry"
    else
        log_info "Adding kernelsu to $driver_makefile"
        printf "\nobj-\$(CONFIG_KSU) += kernelsu/\n" >> "$driver_makefile"
    fi

    # 3. Update drivers/Kconfig: add source "drivers/kernelsu/Kconfig" before endmenu
    if grep -q 'source "drivers/kernelsu/Kconfig"' "$driver_kconfig"; then
        log_debug "Kconfig already has kernelsu entry"
    else
        log_info "Adding kernelsu to $driver_kconfig"
        local tmp_kconfig
        tmp_kconfig=$(mktemp)
        awk '/^endmenu/ && !done { print "source \"drivers/kernelsu/Kconfig\""; done=1 } { print }' "$driver_kconfig" > "$tmp_kconfig"
        mv "$tmp_kconfig" "$driver_kconfig"
    fi

    log_success "KernelSU integrated into kernel source ($driver_dir)"
}

# ============================================================================
# Defconfig Management
# ============================================================================
update_defconfig() {
    local configs=("$@")
    log_step "Updating defconfig: $(basename "$DEFCONFIG_PATH")"

    local backup
    backup=$(backup_file "$DEFCONFIG_PATH")

    local modified=0
    for config in "${configs[@]}"; do
        local key="${config%%=*}"
        local value="${config#*=}"

        if grep -q "^${key}=" "$DEFCONFIG_PATH"; then
            local current
            current=$(grep "^${key}=" "$DEFCONFIG_PATH" | head -1 | cut -d= -f2-)
            if [[ "$current" != "$value" ]]; then
                log_info "Updating $key: $current -> $value"
                if [[ "$value" == "n" ]]; then
                    sed -i "s|^${key}=.*|# ${key} is not set|" "$DEFCONFIG_PATH"
                else
                    sed -i "s|^${key}=.*|${config}|" "$DEFCONFIG_PATH"
                fi
                modified=1
            else
                log_debug "$key already set to $value"
            fi
        elif grep -q "^# ${key} is not set" "$DEFCONFIG_PATH"; then
            if [[ "$value" == "n" ]]; then
                log_debug "$key already disabled"
            else
                log_info "Enabling $key (was disabled)"
                sed -i "s|^# ${key} is not set|${config}|" "$DEFCONFIG_PATH"
                modified=1
            fi
        else
            if [[ "$value" == "n" ]]; then
                log_info "Disabling $key (adding # $key is not set)"
                echo "# ${key} is not set" >> "$DEFCONFIG_PATH"
            else
                log_info "Adding $config"
                echo "$config" >> "$DEFCONFIG_PATH"
            fi
            modified=1
        fi
    done

    # Also ensure CONFIG_KSU is set for both methods
    if ! grep -q "^CONFIG_KSU=" "$DEFCONFIG_PATH" && ! grep -q "^# CONFIG_KSU is not set" "$DEFCONFIG_PATH"; then
        echo "CONFIG_KSU=y" >> "$DEFCONFIG_PATH"
        modified=1
    elif grep -q "^# CONFIG_KSU is not set" "$DEFCONFIG_PATH"; then
        sed -i "s|^# CONFIG_KSU is not set|CONFIG_KSU=y|" "$DEFCONFIG_PATH"
        modified=1
    fi

    if [[ $modified -eq 1 ]]; then
        log_success "Defconfig updated"
    else
        log_info "Defconfig already has required configs"
    fi
}

# ============================================================================
# Manual Method - Patch Application
# ============================================================================
apply_manual_patches() {
    log_step "Applying manual integration patches (KernelSU original: 4 files)"

    local patched_files=()
    local failed_files=()

    for file in "${MANUAL_PATCH_FILES[@]}"; do
        local filepath="$KERNEL_SRC/$file"
        [[ -f "$filepath" ]] || { failed_files+=("$file (not found)"); continue; }

        log_info "Patching $file..."
        if patch_file_manual "$filepath"; then
            patched_files+=("$file")
            log_success "Patched $file"
        else
            failed_files+=("$file (patch failed)")
            log_error "Failed to patch $file"
        fi
    done

    if [[ ${#failed_files[@]} -gt 0 ]]; then
        log_error "Failed to patch: ${failed_files[*]}"
        # Restore backups on failure
        for file in "${patched_files[@]}"; do
            restore_backup "$KERNEL_SRC/$file"
        done
        die "Manual patching failed. Backups restored."
    fi

    log_success "All manual patches applied successfully (${#patched_files[@]} files)"
}

patch_file_manual() {
    local filepath="$1"
    local filename
    filename="$(basename "$filepath")"

    case "$filename" in
        exec.c)
            patch_exec_c "$filepath"
            ;;
        open.c)
            patch_open_c "$filepath"
            ;;
        read_write.c)
            patch_read_write_c "$filepath"
            ;;
        stat.c)
            patch_stat_c "$filepath"
            ;;
        *)
            die "Unknown patch target: $filename"
            ;;
    esac
}

# --- Patch: fs/exec.c ---
# KernelSU original: hooks do_execveat_common with dual hook (execveat + sucompat)
patch_exec_c() {
    local file="$1"

    if verify_patch_applied "$file" "ksu_handle_execveat"; then
        log_debug "exec.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find do_execveat_common function - try multiple patterns
    local execveat_line
    execveat_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+do_execveat_common[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+do_execveat_common[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+__do_execveat_common[[:space:]]*[(]'
    )
    [[ -n "$execveat_line" ]] || { log_error "Could not find do_execveat_common in $file"; return 1; }

    # Add extern declarations before do_execveat_common
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern bool ksu_execveat_hook __read_mostly;
${indent}extern int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
${indent}                       void *envp, int *flags);
${indent}extern int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
${indent}                                void *argv, void *envp, int *flags);
${indent}#endif"
    insert_before_line "$file" "$execveat_line" "$extern_decl"

    # Find the return statement inside do_execveat_common
    # Try __do_execve_file first (standard), then do_execveat_common (some kernels)
    local return_patterns=(
        'return[[:space:]]+__do_execve_file'
        'return[[:space:]]+do_execve_file'
        'return[[:space:]]+do_execveat_common'
    )
    local return_line
    for pattern in "${return_patterns[@]}"; do
        return_line=$(find_function_end "$file" "$execveat_line" "$pattern")
        [[ -n "$return_line" ]] && break
    done

    if [[ -z "$return_line" ]]; then
        # Fallback: find first return statement after function start
        return_line=$(find_function_end "$file" "$execveat_line" 'return[[:space:]]')
    fi

    [[ -n "$return_line" ]] || { log_error "Could not find return statement in do_execveat_common"; return 1; }

    local body_indent
    body_indent=$(detect_indent "$file" "$return_line")

    # Dual hook: ksu_handle_execveat OR ksu_handle_execveat_sucompat
    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    if (unlikely(ksu_execveat_hook))
${body_indent}        ksu_handle_execveat(&fd, &filename, &argv, &envp, &flags);
${body_indent}    else
${body_indent}        ksu_handle_execveat_sucompat(&fd, &filename, &argv, &envp, &flags);
${body_indent}#endif"
    insert_before_line "$file" "$return_line" "$hook_call"

    verify_patch_applied "$file" "ksu_handle_execveat" || { log_error "Patch verification failed for exec.c"; return 1; }

    return 0
}

# --- Patch: fs/open.c ---
# KernelSU original: hooks do_faccessat (or SYSCALL_DEFINE3(faccessat) for kernel < 4.17)
patch_open_c() {
    local file="$1"

    if verify_patch_applied "$file" "ksu_handle_faccessat"; then
        log_debug "open.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Try do_faccessat first (kernel >= 4.17), then fall back to SYSCALL_DEFINE3(faccessat) (< 4.17)
    local faccessat_line
    faccessat_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*long[[:space:]]+do_faccessat[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+do_faccessat[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+long[[:space:]]+do_faccessat[[:space:]]*[(]' \
        '^[[:space:]]*asmlinkage[[:space:]]+long[[:space:]]+do_faccessat[[:space:]]*[(]' \
        '^[[:space:]]*SYSCALL_DEFINE3[[:space:]]*[(][[:space:]]*faccessat'
    )
    [[ -n "$faccessat_line" ]] || { log_error "Could not find do_faccessat/faccessat syscall in $file"; return 1; }

    # Add extern declaration before the function
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern int ksu_handle_faccessat(int *dfd, const char __user **filename_user, int *mode,
${indent}                        int *flags);
${indent}#endif"
    insert_before_line "$file" "$faccessat_line" "$extern_decl"

    # Find the validation check - try multiple patterns
    local check_patterns=(
        'if[[:space:]]*[(][[:space:]]*mode[[:space:]]*&[[:space:]]*~S_IRWXO[[:space:]]*[)]'
        'if[[:space:]]*[(][[:space:]]*mode[[:space:]]*&[[:space:]]*~0777[[:space:]]*[)]'
        'if[[:space:]]*[(][[:space:]]*mode[[:space:]]*&[[:space:]]*~S_IRWXU[[:space:]]*[)]'
    )
    local check_line
    for pattern in "${check_patterns[@]}"; do
        check_line=$(find_function_end "$file" "$faccessat_line" "$pattern")
        [[ -n "$check_line" ]] && break
    done

    if [[ -z "$check_line" ]]; then
        # Fallback: find first if statement in function
        check_line=$(find_function_end "$file" "$faccessat_line" '^[[:space:]]*if[[:space:]]*[(]')
    fi

    [[ -n "$check_line" ]] || { log_error "Could not find insertion point in do_faccessat"; return 1; }

    local body_indent
    body_indent=$(detect_indent "$file" "$check_line")

    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    ksu_handle_faccessat(&dfd, &filename, &mode, NULL);
${body_indent}#endif"
    insert_before_line "$file" "$check_line" "$hook_call"

    verify_patch_applied "$file" "ksu_handle_faccessat" || { log_error "Patch verification failed for open.c"; return 1; }

    return 0
}

# --- Patch: fs/read_write.c ---
# KernelSU original: hooks vfs_read (NOT the syscall) with ksu_handle_vfs_read
patch_read_write_c() {
    local file="$1"

    if verify_patch_applied "$file" "ksu_handle_vfs_read"; then
        log_debug "read_write.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find vfs_read function (NOT ksys_read, NOT SYSCALL_DEFINE)
    local vfs_read_line
    vfs_read_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*ssize_t[[:space:]]+vfs_read[[:space:]]*[(]' \
        '^[[:space:]]*ssize_t[[:space:]]+__vfs_read[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+ssize_t[[:space:]]+vfs_read[[:space:]]*[(]'
    )
    [[ -n "$vfs_read_line" ]] || { log_error "Could not find vfs_read in $file"; return 1; }

    # Add extern declarations before vfs_read
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern bool ksu_vfs_read_hook __read_mostly;
${indent}extern int ksu_handle_vfs_read(struct file **file_ptr, char __user **buf_ptr,
${indent}                       size_t *count_ptr, loff_t **pos);
${indent}#endif"
    insert_before_line "$file" "$vfs_read_line" "$extern_decl"

    # Find ssize_t ret declaration directly from the function signature line.
    # This handles both brace styles (brace on own line vs. same line as signature).
    # If ssize_t ret is found, insert after it. Otherwise, insert after the
    # first line containing '{' (the opening brace, regardless of position).
    local ret_line
    ret_line=$(find_function_end "$file" "$vfs_read_line" 'ssize_t[[:space:]]+ret')

    local insert_target
    if [[ -n "$ret_line" ]]; then
        # Insert after ssize_t ret declaration
        insert_target="$ret_line"
    else
        # Fallback: find the opening brace (on its own line or at end of a line)
        local brace_line
        brace_line=$(find_function_end "$file" "$vfs_read_line" '[{]')
        [[ -n "$brace_line" ]] || { log_error "Could not find opening brace of vfs_read"; return 1; }
        insert_target="$brace_line"
    fi

    local body_indent
    body_indent=$(detect_indent "$file" "$insert_target")

    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    if (unlikely(ksu_vfs_read_hook))
${body_indent}        ksu_handle_vfs_read(&file, &buf, &count, &pos);
${body_indent}#endif"
    insert_after_line "$file" "$insert_target" "$hook_call"

    verify_patch_applied "$file" "ksu_handle_vfs_read" || { log_error "Patch verification failed for read_write.c"; return 1; }

    return 0
}

# --- Patch: fs/stat.c ---
# KernelSU original: hooks vfs_statx (or vfs_fstatat fallback for older kernels)
patch_stat_c() {
    local file="$1"

    if verify_patch_applied "$file" "ksu_handle_stat"; then
        log_debug "stat.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Try vfs_statx first (newer kernels), then fall back to vfs_fstatat (older)
    local statx_line
    statx_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*int[[:space:]]+vfs_statx[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+vfs_statx[[:space:]]*[(]' \
        '^[[:space:]]*int[[:space:]]+vfs_fstatat[[:space:]]*[(]' \
        '^[[:space:]]*static[[:space:]]+int[[:space:]]+vfs_fstatat[[:space:]]*[(]'
    )
    [[ -n "$statx_line" ]] || { log_error "Could not find vfs_statx or vfs_fstatat in $file"; return 1; }

    # Determine which function was found (affects variable name: flags vs flag)
    local func_name
    func_name=$(sed -n "${statx_line}p" "$file" | grep -oE 'vfs_statx|vfs_fstatat' | head -1)

    # Add extern declaration before the function
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern int ksu_handle_stat(int *dfd, const char __user **filename_user, int *flags);
${indent}#endif"
    insert_before_line "$file" "$statx_line" "$extern_decl"

    # Find the error/validation check after the function opening
    # vfs_statx uses 'flags', vfs_fstatat uses 'flag'
    local check_patterns=(
        'if[[:space:]]*[(][[:space:]]*[(]?[[:space:]]*flags[[:space:]]*&[[:space:]]*~'
        'if[[:space:]]*[(][[:space:]]*[(]?[[:space:]]*flag[[:space:]]*&[[:space:]]*~'
        'error[[:space:]]*=[[:space:]]*-EINVAL'
        'int[[:space:]]+error[[:space:]]*='
    )
    local check_line
    for pattern in "${check_patterns[@]}"; do
        check_line=$(find_function_end "$file" "$statx_line" "$pattern")
        [[ -n "$check_line" ]] && break
    done

    if [[ -z "$check_line" ]]; then
        # Fallback: find opening brace (handles both brace-on-own-line and brace-on-same-line styles)
        local brace_line
        brace_line=$(find_function_end "$file" "$statx_line" '[{]')
        if [[ -n "$brace_line" ]]; then
            check_line=$((brace_line + 1))
        else
            check_line="$statx_line"
        fi
    fi

    local body_indent
    body_indent=$(detect_indent "$file" "$check_line")

    # Use appropriate variable name (flags for vfs_statx, flag for vfs_fstatat)
    local var_name="flags"
    if [[ "$func_name" == "vfs_fstatat" ]]; then
        var_name="flag"
    fi

    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    ksu_handle_stat(&dfd, &filename, &${var_name});
${body_indent}#endif"
    insert_before_line "$file" "$check_line" "$hook_call"

    verify_patch_applied "$file" "ksu_handle_stat" || { log_error "Patch verification failed for stat.c"; return 1; }

    return 0
}

# ============================================================================
# Backport Functions
# ============================================================================

# --- Backport 1: fs/namespace.c (path_umount from kernel 5.9) ---
# Required for "Umount module" feature on kernels older than 5.9
patch_namespace_c() {
    local file="$1"

    if verify_patch_applied "$file" "$BACKPORT_PATH_UMOUNT_HOOK"; then
        log_debug "namespace.c already has $BACKPORT_PATH_UMOUNT_HOOK, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find insertion anchor: 'may_mandlock' function.
    # The official patch places path_umount right after may_mandlock's
    # '#endif' line, before the "Now umount can handle mount points" comment.
    #
    # Strategy:
    #   1. Find 'may_mandlock' function start
    #   2. Find the '#endif' line that closes the #if around may_mandlock
    #   3. Insert the path_umount block right after that endif
    #   Fallback: insert before the "Now umount" comment block
    #   Last resort: append to end of file
    #
    # Note: We use awk directly (not patch_with_fallback) because may_mandlock
    # is optional - its absence should trigger the fallback, not an error.

    local may_mandlock_line
    may_mandlock_line=$(awk '/may_mandlock/ { print NR; exit }' "$file")

    local insert_line=""

    if [[ -n "$may_mandlock_line" ]]; then
        # Find the first '#endif' after may_mandlock (closing its #if guard)
        local endif_line
        endif_line=$(awk -v start="$may_mandlock_line" '
            NR > start && /^[[:space:]]*#endif/ { print NR; exit }
        ' "$file")
        if [[ -n "$endif_line" ]]; then
            insert_line=$((endif_line + 1))
        fi
    fi

    # Fallback: find the "Now umount" comment block and insert before it
    if [[ -z "$insert_line" ]]; then
        local now_umount_line
        now_umount_line=$(awk '/Now umount can handle mount points/ { print NR; exit }' "$file")
        if [[ -n "$now_umount_line" ]]; then
            insert_line="$now_umount_line"
        fi
    fi

    # Last-resort fallback: append to end of file
    if [[ -z "$insert_line" ]]; then
        log_warn "Could not find may_mandlock anchor in namespace.c; appending path_umount at end of file"
        insert_line=$(wc -l < "$file")
        insert_line=$((insert_line + 1))
    fi

    # The path_umount backport block (verbatim from KernelSU original docs)
    local backport_block="${indent}#ifdef CONFIG_KSU
${indent}static int can_umount(const struct path *path, int flags)
${indent}{
${indent}       struct mount *mnt = real_mount(path->mnt);
${indent}
${indent}       if (flags & ~(MNT_FORCE | MNT_DETACH | MNT_EXPIRE | UMOUNT_NOFOLLOW))
${indent}               return -EINVAL;
${indent}       if (!may_mount())
${indent}               return -EPERM;
${indent}       if (path->dentry != path->mnt->mnt_root)
${indent}               return -EINVAL;
${indent}       if (!check_mnt(mnt))
${indent}               return -EINVAL;
${indent}       if (mnt->mnt.mnt_flags & MNT_LOCKED) /* Check optimistically */
${indent}               return -EINVAL;
${indent}       if (flags & MNT_FORCE && !capable(CAP_SYS_ADMIN))
${indent}               return -EPERM;
${indent}       return 0;
${indent}}
${indent}
${indent}int path_umount(struct path *path, int flags)
${indent}{
${indent}       struct mount *mnt = real_mount(path->mnt);
${indent}       int ret;
${indent}
${indent}       ret = can_umount(path, flags);
${indent}       if (!ret)
${indent}               ret = do_umount(mnt, flags);
${indent}
${indent}       /* we mustn't call path_put() as that would clear mnt_expiry_mark */
${indent}       dput(path->dentry);
${indent}       mntput_no_expire(mnt);
${indent}       return ret;
${indent}}
${indent}#endif"

    insert_before_line "$file" "$insert_line" "$backport_block"

    verify_patch_applied "$file" "$BACKPORT_PATH_UMOUNT_HOOK" \
        || { log_error "Patch verification failed for namespace.c (path_umount)"; return 1; }

    return 0
}

apply_backport_path_umount() {
    log_step "Applying path_umount backport (KernelSU original, for pre-5.9 kernels)"

    local filepath="$KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE"

    if [[ ! -f "$filepath" ]]; then
        log_error "File not found: $filepath"
        return 1
    fi

    log_info "Patching $BACKPORT_PATH_UMOUNT_FILE..."

    if patch_namespace_c "$filepath"; then
        log_success "Patched $BACKPORT_PATH_UMOUNT_FILE (path_umount backport applied)"
    else
        log_error "Failed to patch $BACKPORT_PATH_UMOUNT_FILE"
        return 1
    fi

    return 0
}

# --- Backport 2: fs/devpts/inode.c (fix "pm execution failed") ---
# Patches devpts_get_priv to call ksu_handle_devpts
patch_devpts_c() {
    local file="$1"

    if verify_patch_applied "$file" "$BACKPORT_DEVPTS_HOOK"; then
        log_debug "devpts/inode.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find devpts_get_priv function
    local devpts_line
    devpts_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*void[[:space:]]*[*][[:space:]]*devpts_get_priv[[:space:]]*[(]' \
        '^[[:space:]]*void[[:space:]]+devpts_get_priv[[:space:]]*[(]' \
        '^[[:space:]]*devpts_get_priv[[:space:]]*[(]'
    )
    [[ -n "$devpts_line" ]] || { log_error "Could not find devpts_get_priv in $file"; return 1; }

    # Add extern declaration before the function
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern int ksu_handle_devpts(struct inode*);
${indent}#endif"
    insert_before_line "$file" "$devpts_line" "$extern_decl"

    # Find the function body - search for first executable statement directly
    # from the function signature line. This handles both brace styles:
    #   Style 1 (kernel standard): brace on its own line
    #     void *devpts_get_priv(struct dentry *dentry)
    #     {
    #   Style 2 (compact): brace on same line as signature
    #     void *devpts_get_priv(struct dentry *dentry) {
    # The official patch inserts ksu_handle_devpts(dentry->d_inode) at the start
    # of devpts_get_priv, before the dentry->d_sb->s_magic check.
    local body_patterns=(
        'dentry->d_sb'
        'dentry->d_inode'
        'return[[:space:]]'
        'if[[:space:]]*[(]'
    )
    local body_line
    for pattern in "${body_patterns[@]}"; do
        body_line=$(find_function_end "$file" "$devpts_line" "$pattern")
        [[ -n "$body_line" ]] && break
    done

    [[ -n "$body_line" ]] || { log_error "Could not find insertion point in devpts_get_priv"; return 1; }

    local body_indent
    body_indent=$(detect_indent "$file" "$body_line")

    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    ksu_handle_devpts(dentry->d_inode);
${body_indent}#endif"
    insert_before_line "$file" "$body_line" "$hook_call"

    verify_patch_applied "$file" "$BACKPORT_DEVPTS_HOOK" \
        || { log_error "Patch verification failed for devpts/inode.c"; return 1; }

    return 0
}

apply_backport_devpts() {
    log_step "Applying devpts backport (fix 'pm execution failed' in terminal)"

    local filepath="$KERNEL_SRC/$BACKPORT_DEVPTS_FILE"

    if [[ ! -f "$filepath" ]]; then
        log_error "File not found: $filepath"
        return 1
    fi

    log_info "Patching $BACKPORT_DEVPTS_FILE..."

    if patch_devpts_c "$filepath"; then
        log_success "Patched $BACKPORT_DEVPTS_FILE (devpts backport applied)"
    else
        log_error "Failed to patch $BACKPORT_DEVPTS_FILE"
        return 1
    fi

    return 0
}

# --- Backport 3: drivers/input/input.c (Safe Mode) ---
# Patches input_handle_event to call ksu_handle_input_handle_event
patch_input_c() {
    local file="$1"

    if verify_patch_applied "$file" "$BACKPORT_SAFE_MODE_HOOK"; then
        log_debug "input.c already patched, skipping"
        return 0
    fi

    local backup
    backup=$(backup_and_verify "$file") || return 1

    local indent
    indent=$(detect_indent "$file" 1)

    # Find input_handle_event function
    local input_line
    input_line=$(patch_with_fallback "$file" \
        '^[[:space:]]*static[[:space:]]+void[[:space:]]+input_handle_event[[:space:]]*[(]' \
        '^[[:space:]]*void[[:space:]]+input_handle_event[[:space:]]*[(]' \
        '^[[:space:]]*input_handle_event[[:space:]]*[(]'
    )
    [[ -n "$input_line" ]] || { log_error "Could not find input_handle_event in $file"; return 1; }

    # Add extern declarations before the function
    local extern_decl="${indent}#ifdef CONFIG_KSU
${indent}extern bool ksu_input_hook __read_mostly;
${indent}extern int ksu_handle_input_handle_event(unsigned int *type, unsigned int *code, int *value);
${indent}#endif"
    insert_before_line "$file" "$input_line" "$extern_decl"

    # Find input_get_disposition call inside the function
    # The official patch inserts the hook AFTER the input_get_disposition call
    local disposition_line
    disposition_line=$(find_function_end "$file" "$input_line" 'input_get_disposition')
    [[ -n "$disposition_line" ]] || { log_error "Could not find input_get_disposition call in input_handle_event"; return 1; }

    local body_indent
    body_indent=$(detect_indent "$file" "$disposition_line")

    # Insert AFTER the input_get_disposition line
    local hook_call="${body_indent}#ifdef CONFIG_KSU
${body_indent}    if (unlikely(ksu_input_hook))
${body_indent}        ksu_handle_input_handle_event(&type, &code, &value);
${body_indent}#endif"
    insert_after_line "$file" "$disposition_line" "$hook_call"

    verify_patch_applied "$file" "$BACKPORT_SAFE_MODE_HOOK" \
        || { log_error "Patch verification failed for input.c"; return 1; }

    return 0
}

apply_backport_safe_mode() {
    log_step "Applying Safe Mode backport (drivers/input/input.c)"

    local filepath="$KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE"

    if [[ ! -f "$filepath" ]]; then
        log_error "File not found: $filepath"
        return 1
    fi

    log_info "Patching $BACKPORT_SAFE_MODE_FILE..."

    if patch_input_c "$filepath"; then
        log_success "Patched $BACKPORT_SAFE_MODE_FILE (Safe Mode backport applied)"
        log_warn "If using manual integration, ensure CONFIG_KPROBES is disabled in defconfig"
        log_warn "  to prevent accidental Safe Mode triggers (volume down button after boot)"
    else
        log_error "Failed to patch $BACKPORT_SAFE_MODE_FILE"
        return 1
    fi

    return 0
}

# ============================================================================
# Kprobe Method - Config Only
# ============================================================================
apply_kprobe_configs() {
    log_step "Applying kprobe method configurations"

    update_defconfig "${KPROBE_CONFIGS[@]}"

    log_success "Kprobe configurations applied to defconfig"
    log_info "Note: Verify kprobe works on your kernel. If bootloop occurs, kprobe may be broken."
    log_info "Test: Comment out ksu_sucompat_init() and ksu_ksud_init() in KernelSU/kernel/ksu.c"
    log_info "If kernel < 5.9, also use --backport-path_umount for 'Umount module' feature"
}

# ============================================================================
# Verification
# ============================================================================
verify_integration() {
    log_step "Verifying integration"

    # Standalone backport mode: only verify the specific backport patches
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        local backport_errors=()

        if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
            local ns_file="$KERNEL_SRC/$BACKPORT_PATH_UMOUNT_FILE"
            if [[ -f "$ns_file" ]]; then
                grep -q "$BACKPORT_PATH_UMOUNT_HOOK" "$ns_file" \
                    || backport_errors+=("path_umount not found in $BACKPORT_PATH_UMOUNT_FILE")
            else
                backport_errors+=("$BACKPORT_PATH_UMOUNT_FILE not found")
            fi
        fi

        if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
            local devpts_file="$KERNEL_SRC/$BACKPORT_DEVPTS_FILE"
            if [[ -f "$devpts_file" ]]; then
                grep -q "$BACKPORT_DEVPTS_HOOK" "$devpts_file" \
                    || backport_errors+=("devpts hook not found in $BACKPORT_DEVPTS_FILE")
            else
                backport_errors+=("$BACKPORT_DEVPTS_FILE not found")
            fi
        fi

        if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
            local input_file="$KERNEL_SRC/$BACKPORT_SAFE_MODE_FILE"
            if [[ -f "$input_file" ]]; then
                grep -q "$BACKPORT_SAFE_MODE_HOOK" "$input_file" \
                    || backport_errors+=("safe_mode hook not found in $BACKPORT_SAFE_MODE_FILE")
            else
                backport_errors+=("$BACKPORT_SAFE_MODE_FILE not found")
            fi
        fi

        if [[ ${#backport_errors[@]} -gt 0 ]]; then
            die "Backport verification failed: ${backport_errors[*]}"
        fi

        log_success "Backport patches verified successfully"
        return
    fi

    # Normal mode: full integration verification
    # Check KernelSU source exists (external submodule structure)
    [[ -d "$KSU_KERNEL_SOURCE" ]] || die "KernelSU kernel source missing at $KSU_KERNEL_SOURCE"
    [[ -f "$KSU_KERNEL_SOURCE/Kconfig" ]] || die "KernelSU source incomplete - Kconfig missing"
    [[ -f "$KSU_KERNEL_SOURCE/core/init.c" ]] || die "KernelSU source incomplete - core/init.c missing"

    # Check symlink exists in kernel source
    local driver_dir
    if [[ -d "$KERNEL_SRC/common/drivers" ]]; then
        driver_dir="common/drivers"
    elif [[ -d "$KERNEL_SRC/drivers" ]]; then
        driver_dir="drivers"
    else
        die "Could not find drivers/ directory in kernel source"
    fi
    [[ -L "$KERNEL_SRC/$driver_dir/kernelsu" ]] || die "kernelsu symlink missing in $driver_dir"

    # Check defconfig has CONFIG_KSU
    grep -q "^CONFIG_KSU=y" "$DEFCONFIG_PATH" || die "CONFIG_KSU not enabled in defconfig"

    if [[ "$METHOD" == "kprobe" ]]; then
        for config in "${KPROBE_CONFIGS[@]}"; do
            local key="${config%%=*}"
            grep -q "^${key}=y" "$DEFCONFIG_PATH" || log_warn "Config not set: $key"
        done
    else
        # Verify patches applied by checking for hook calls (4 files)
        local missing_hooks=()
        grep -q "ksu_handle_execveat" "$KERNEL_SRC/fs/exec.c" || missing_hooks+=("exec.c")
        grep -q "ksu_handle_faccessat" "$KERNEL_SRC/fs/open.c" || missing_hooks+=("open.c")
        grep -q "ksu_handle_vfs_read" "$KERNEL_SRC/fs/read_write.c" || missing_hooks+=("read_write.c")
        grep -q "ksu_handle_stat" "$KERNEL_SRC/fs/stat.c" || missing_hooks+=("stat.c")

        if [[ ${#missing_hooks[@]} -gt 0 ]]; then
            die "Manual patches incomplete. Missing hooks in: ${missing_hooks[*]}"
        fi
    fi

    log_success "Integration verified successfully"
}

# ============================================================================
# Main
# ============================================================================
main() {
    validate_args "$@"
    check_prerequisites

    log_info "KernelSU (original) Integration Script v$SCRIPT_VERSION"
    log_info "Method: $METHOD | Kernel: $KERNEL_SRC | Defconfig: ${DEFCONFIG_PATH:-<none>}"

    # =========================================================================
    # Standalone backport mode
    # Only apply the specified backport(s). Skip all other steps.
    # =========================================================================
    if [[ $ANY_BACKPORT_SET -eq 1 ]]; then
        log_step "Standalone backport mode: $(get_backport_list)"

        if [[ $BACKPORT_PATH_UMOUNT -eq 1 ]]; then
            apply_backport_path_umount || die "path_umount backport failed"
        fi
        if [[ $BACKPORT_DEVPTS -eq 1 ]]; then
            apply_backport_devpts || die "devpts backport failed"
        fi
        if [[ $BACKPORT_SAFE_MODE -eq 1 ]]; then
            apply_backport_safe_mode || die "safe_mode backport failed"
        fi

        verify_integration

        log_step "Integration Complete"
        log_success "Backport patches applied: $(get_backport_list)"
        log_info "Backup files created: *.ksu-backup.* in patched directories"
        log_info "Next steps:"
        log_info "  1. Build your kernel: make -C $KERNEL_SRC"
        log_info "  2. Flash the resulting boot.img"
        return
    fi

    # =========================================================================
    # Normal flow: full KSU integration
    # =========================================================================

    # Pre-flight detection of existing KSU integration
    detect_existing_ksu

    fetch_ksu_source

    case "$METHOD" in
        kprobe)
            apply_kprobe_configs
            ;;
        manual)
            # Per docs: manual method only needs CONFIG_KSU=y
            # Also disable kprobe configs to prevent conflicts
            log_step "Configuring defconfig for manual method"
            update_defconfig "CONFIG_KPROBES=n" "CONFIG_HAVE_KPROBES=n" "CONFIG_KPROBE_EVENTS=n"
            update_defconfig "${MANUAL_CONFIGS[@]}"
            apply_manual_patches
            ;;
    esac

    verify_integration

    log_step "Integration Complete"
    log_success "KernelSU (original, tag: $KSU_TAG) integrated using '$METHOD' method"
    log_info "Next steps:"
    log_info "  1. Build your kernel: make -C $KERNEL_SRC $(basename "$DEFCONFIG_PATH") && make -C $KERNEL_SRC"
    log_info "  2. Flash the resulting boot.img"
    log_info "  3. If using kprobe and bootloops: kprobe is broken, use 'manual' method instead"

    if [[ "$METHOD" == "manual" ]]; then
        log_info "  Backup files created: *.ksu-backup.* in each patched directory"
        log_info "  Optional backports (run separately if needed):"
        log_info "    --backport-path_umount  (for 'Umount module' on pre-5.9 kernels)"
        log_info "    --backport-devpts       (fixes 'pm' execution in terminal)"
        log_info "    --backport-safe-mode    (enables Safe Mode)"
        log_info "    --backport-all          (all three above)"
    fi
}

# Handle script arguments
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
        show_usage
        exit 0
    fi
    main "$@"
fi
